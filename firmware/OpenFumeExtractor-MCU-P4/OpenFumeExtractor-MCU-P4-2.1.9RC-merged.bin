      else if(!p01&&c===0x59&&p.length===3){let v=u16le(p);h=jbcField('MosTemp',jbcUsbTempDiag(v),'primary')+jbcField('Port',jbcUsbPortText(p[2]));summary=jbcUsbTempDiag(v).split(' Â· ')[0];}
      else if((p01&&c===0x59&&p.length===3)||(!p01&&c===0x5A&&p.length===4)){let t=u16le(p),fm=p[2],mode=fm?String.fromCharCode(fm):'-',port=!p01?Number(p[3]):reqPort();h=jbcField(u('Countdown','Countdown'),(t===65535?0:t)+' s','primary')+jbcField(u('NÃ¤chster Modus','Next mode'),mode)+(port===null?'':jbcField('Port',jbcUsbPortText(port)));summary=(t===65535?0:t)+' s â†’ '+mode;}
