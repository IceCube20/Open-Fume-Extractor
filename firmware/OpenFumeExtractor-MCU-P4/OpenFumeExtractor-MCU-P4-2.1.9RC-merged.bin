const $=name=>document.getElementById('rq_'+name);if(!$('start'))return;
const de=()=>{const e=document.getElementById('lang_sel');return !e||e.value!=='en';},say=(a,b)=>de()?a:b;
let last=null,receivedAt=0,session=null;
const labels={running:['Messung lÃ¤uft','Measuring'],ok:['Keine Fehler im Messfenster','No errors in observation window'],errors:['Kommunikationsfehler gemessen','Communication errors observed'],no_response:['Keine Antworten empfangen','No responses received'],insufficient:['Zu wenig Verkehr fÃ¼r eine Bewertung','Insufficient traffic for assessment'],inconclusive:['Messung nicht vollstÃ¤ndig auswertbar','Observation inconclusive']};
function render(){
 document.querySelectorAll('[data-rq-de]').forEach(e=>e.textContent=e.getAttribute(de()?'data-rq-de':'data-rq-en'));
 const report=session&&session.report(),active=report&&report.result==='running';
 $('start').disabled=!!active||!last||performance.now()-receivedAt>2000||!(last.modules||[]).some(m=>m.transport==='rs485');$('stop').disabled=!active;$('duration').disabled=!!active;$('export').disabled=!report||!!active;
 if(!report){$('state').textContent=say('Bereit Â· passiv Â· 250 kBaud','Ready Â· passive Â· 250 kbaud');return;}
 $('state').textContent=labels[report.result][de()?0:1]+' Â· '+(report.elapsed_ms/1000).toFixed(1)+' s Â· '+report.samples+' '+say('Messwerte','samples');
 $('progress').value=Math.min(session.duration,report.elapsed_ms);$('progress').max=session.duration;
 const rows=$('rows');rows.replaceChildren();
 for(const m of report.modules){const tr=document.createElement('tr');for(const value of ['0x'+m.addr.toString(16).toUpperCase()+' '+m.name,m.requests,m.responses,m.timeouts,m.bad_seq+m.bad_cmd,m.sampled_latency_max_ms+' ms']){const td=document.createElement('td');td.textContent=value;tr.appendChild(td);}rows.appendChild(tr);}
 $('errors').textContent='CRC '+report.parser_errors.ofe_crc_errors+' Â· LEN '+report.parser_errors.ofe_bad_length+' Â· ESC '+report.parser_errors.ofe_escape_errors+' Â· '+say('Weitere','Other')+' '+(report.parser_errors.ofe_bad_version+report.parser_errors.ofe_overflow_errors+report.parser_errors.ofe_short_frames)+' Â· '+say('Antwortlose Fenster','No-response windows')+' '+report.no_response_windows+' Â· '+say('Antworten wiederaufgenommen','Response resumptions')+' '+report.response_resumptions;
}
