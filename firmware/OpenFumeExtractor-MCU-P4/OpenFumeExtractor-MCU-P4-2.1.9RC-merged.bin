    0x40:'M_W_PEDALMODE',0x41:'M_R_FILTERSTATUS',0x42:'M_R_RESETFILTER',0x44:'M_R_CONNECTEDPEDAL',
    0x45:'M_R_FILTERSAT',0x51:'M_R_PIN',0x52:'M_W_PIN',0x53:'M_R_STATIONLOCKED',
