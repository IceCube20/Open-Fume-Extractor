  if(f&16)parts.push(row(uiLang=='de'?'Alarm min. / VerzÃ¶gerung':'Alarm min / delay',`${jbcUsbTemp(p.sold_alarm_min_temp)} / ${(Number(p.sold_alarm_min_delay_tenth_sec||0)/10).toFixed(1)} s`));
