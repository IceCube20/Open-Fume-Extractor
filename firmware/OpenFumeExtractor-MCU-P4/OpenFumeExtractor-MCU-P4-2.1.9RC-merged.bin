      else if(!p01&&c===0x70&&p.length===12){h=jbcField('WorkingMode',String(p[0]),'primary')+jbcField(u('Programm','Program'),String(p[1]))+jbcField(u('LieferlÃ¤nge raw','Delivery length raw'),String(u16le(p,2)))+jbcField(u('Liefergeschwindigkeit raw','Delivery speed raw'),String(u16le(p,4)))+jbcField('Tin diameter',String(p[6]))+jbcField('Remove length',String(p[7]))+bool('Speed/Length readonly',p[8])+jbcField('Selectable programs','0x'+u16le(p,9).toString(16).toUpperCase())+bool('Clogging detection',p[11]);summary='ALE mode '+p[0]+' Â· program '+p[1];}
