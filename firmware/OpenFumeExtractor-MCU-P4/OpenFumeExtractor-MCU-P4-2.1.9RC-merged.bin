<div class="stat-cell"><div class="k" data-i18n="master_serial_number">Serial number</div><div id="master_serial_number" class="v mini" style="overflow-wrap:anywhere">-</div></div>
<div class="stat-cell"><div class="k">IP</div><div id="master_ip" class="v mini">-</div></div>
<div class="stat-cell wifi-cell"><div id="network_title" class="k" data-i18n="wifi_signal">WiFi Signal</div><div id="wifi_meter" class="wifi-meter"><div class="wifi-bar"><div id="wifi_fill" class="wifi-fill"></div></div><div id="wifi_db" class="wifi-db">-</div></div><div id="network_mode" class="ethernet-status" hidden><span id="lan_port" class="lan-port" role="img" aria-label="LAN"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 8v1m4-1v1m4-1v1M19 17a2 2 0 0 0-1.765 1.059l-.47.882A2 2 0 0 1 15 20H9a2 2 0 0 1-1.765-1.059l-.47-.882A2 2 0 0 0 5 17H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2ZM6 8v1"/></svg><span id="lan_link" class="lan-led lan-link"></span><span id="lan_activity" class="lan-led lan-activity"></span></span><div class="ethernet-label"><strong>Ethernet</strong><small id="ethernet_details"></small></div></div><div id="wifi_ssid" class="ssid">-</div></div>
<div class="stat-cell"><div class="k" data-i18n="uptime">Uptime</div><div id="uptime" class="v mini">-</div></div>
<div class="stat-cell"><div class="k" data-i18n="datetime">Date/Time</div><div id="datetime" class="v mini">-</div></div>
<div class="stat-cell dev-only"><div class="k" data-i18n="heap_free">Free Heap</div><div id="heap" class="v mini">-</div></div>
<div class="stat-cell dev-only"><div class="k">Heap Diagnose</div><div id="heap_diag" class="v mini">-</div><div id="heap_diag_low" class="mini">-</div><div id="heap_diag_block" class="mini">-</div></div>
<div class="stat-cell"><div class="k" data-i18n="cpu_load">CPU</div><div id="cpu_load" class="v mini">-</div><div class="bar"><div id="loop_fill" class="fill"></div></div><div id="cpu_cores" class="mini">-</div><div id="loop_max_dev" class="mini dev-only">-</div></div>
