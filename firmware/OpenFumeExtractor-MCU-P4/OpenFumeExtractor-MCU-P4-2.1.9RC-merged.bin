function jbcUsbToolNameDiag(id){
  id=Number(id||0)&255;
  const names={0:'-',1:'T210',2:'T245',3:'PA',4:'HT',5:'DS',6:'DR',7:'NT105',8:'NP105',9:'T470',10:'ALE250',31:'JT',32:'TE',33:'PHS',34:'PHB'};
