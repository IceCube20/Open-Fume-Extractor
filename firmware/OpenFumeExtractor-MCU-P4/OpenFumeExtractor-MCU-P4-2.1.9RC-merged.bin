  if(f&2048){let en=(f&4096)!=0;parts.push(`<div class="jbu-port-detail-item"><span class="k">${uiLang=='de'?'Port freigegeben':'Enabled port'}</span><strong>${en?(uiLang=='de'?'ja':'yes'):(uiLang=='de'?'nein':'no')}</strong></div>`)}
