      else if(p01&&c===0x33&&p.length===1){h=jbcField(u('AusgewÃ¤hltes Level','Selected level'),p[0]===255?'NONE':String(Number(p[0])+1),'primary');summary=p[0]===255?'NONE':'L'+(Number(p[0])+1);}
      else if(p01&&(c===0x35||c===0x37||c===0x39)&&p.length===2){let v=u16le(p),n=c===0x35?1:(c===0x37?2:3);h=jbcField('Level '+n,jbcUsbTempDiag(v),'primary');summary=jbcUsbTempDiag(v).split(' Â· ')[0];}
