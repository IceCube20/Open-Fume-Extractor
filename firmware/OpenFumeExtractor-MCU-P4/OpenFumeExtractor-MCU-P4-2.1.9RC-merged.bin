function jbcFaeDbgOn(v){return Number(v||0)?t('on'):t('off')}
function jbcFaeDbgFilter(v){v=Math.max(0,Math.min(1000,Number(v||0)));return v+' / 1000 ('+(v/10).toFixed(1)+' %)'}
function jbcFaeDbgPair(tx,rx,unit=''){let a=String(tx),b=(rx===null||typeof rx==='undefined')?'-':String(rx),u=unit?(' '+unit):'';return 'TX '+a+u+' Â· RX '+b+u}
function jbcFaeDebugUpdate(d,m){if(!devMode)return;let j=d.jbc||{},valid=!!m.jbc_dbg_settings_valid,rx=k=>valid?m[k]:null,txOut=Object.prototype.hasOwnProperty.call(d,'jbc_fae_output_tx')?!!d.jbc_fae_output_tx:null,rxOut=m.jbc_dbg_extractor_output_valid?!!m.jbc_dbg_extractor_output_rx:null;set('jbc_dbg_output_'+m.addr,'TX '+(txOut===null?'-':jbcFaeDbgOn(txOut))+' Â· RX '+(rxOut===null?'-':jbcFaeDbgOn(rxOut)));set('jbc_dbg_workmask_'+m.addr,'0x'+Number(m.jbc_work_mask||0).toString(16).toUpperCase().padStart(2,'0'));set('jbc_dbg_standmask_'+m.addr,'0x'+Number(m.jbc_stand_mask||0).toString(16).toUpperCase().padStart(2,'0'));set('jbc_dbg_suction_'+m.addr,jbcFaeDbgPair(Number(j.suction_level||0),rx('jbc_dbg_suction_level_rx')));set('jbc_dbg_flowset_'+m.addr,jbcFaeDbgPair(Number(j.select_flow||0),rx('jbc_dbg_select_flow_rx')));set('jbc_dbg_flow_'+m.addr,String(Number(m.jbc_dbg_actual_flow_rx||0)));set('jbc_dbg_speed_'+m.addr,String(Number(m.jbc_dbg_speed_rpm_rx||0))+' rpm');set('jbc_dbg_workdelay_'+m.addr,jbcFaeDbgPair(Number(j.delay_work_sec||0),rx('jbc_dbg_delay_work_sec_rx'),'s'));set('jbc_dbg_standdelay_'+m.addr,jbcFaeDbgPair(Number(j.delay_stand_sec||0),rx('jbc_dbg_delay_stand_sec_rx'),'s'));set('jbc_dbg_standintakes_'+m.addr,'TX '+jbcFaeDbgOn(j.stand_intakes)+' Â· RX '+(valid?jbcFaeDbgOn(m.jbc_dbg_stand_intakes_rx):'-'));set('jbc_dbg_cont_'+m.addr,'TX '+jbcFaeDbgOn(j.continuous)+' Â· RX '+(valid?jbcFaeDbgOn(m.jbc_dbg_continuous_rx):'-'));set('jbc_dbg_filterlife_'+m.addr,'TX '+jbcFaeDbgFilter(j.filter_life)+' Â· RX '+jbcFaeDbgFilter(m.jbc_filter_life_rx));set('jbc_dbg_filtersat_'+m.addr,'TX '+jbcFaeDbgFilter(j.filter_sat)+' Â· RX '+jbcFaeDbgFilter(m.jbc_filter_sat_rx));set('jbc_dbg_error_'+m.addr,'TX 0x'+Number(j.stat_error||0).toString(16).toUpperCase().padStart(4,'0')+' Â· RX 0x'+Number(m.jbc_stat_error_rx||0).toString(16).toUpperCase().padStart(4,'0'))}
function fanIoDescriptorHeader(m,key,def=''){let text=String((m&&m.universal_descriptor)||'');if(!text&&m){let c=universalDescriptorCache[m.addr];if(c&&Number(c.crc)===Number(m.universal_descriptor_crc))text=String(c.text||'')}let prefix=String(key).toLowerCase()+'=';for(let line of universalLines(text)){let s=line.trim();if(s.toLowerCase().startsWith(prefix))return s.slice(prefix.length).trim()}return def}
function fanIoMainConfigured(m){if(!m||(m.type!=2&&m.type!=3))return false;let h=fanIoDescriptorHeader(m,'fan_enabled','');if(h!=='')return Number(h)>0;return (Number(m.caps||0)&36)!=0}
function fanIoDef(m,id){return universalDefsForModule(m).find(d=>Number(d.id)===Number(id))||null}
function fanIoPin(v){if(v===null||v===undefined||v==='')return -1;v=Number(v);return Number.isFinite(v)&&v>=0&&v<255?v:-1}
function fanIoChannelRow(m,output,index){let id=(output?40:20)+index,d=fanIoDef(m,id),meta=d?d.meta:{},enabled=!!d,name=d?(d.label||d.key):((output?'OUT':'IN')+(index+1)),pin=fanIoPin(meta.gpio),active=Number(meta.active_low||0)>0,pull=String(meta.pull||'none').toLowerCase();return `<div class="cal-grid" style="align-items:end"><label>${output?(uiLang=='de'?'Ausgang':'Output'):(uiLang=='de'?'Eingang':'Input')} ${index+1}<input id="fi_name_${m.addr}_${output?1:0}_${index}" maxlength="18" value="${escHtml(name)}"></label><label>GPIO<input id="fi_pin_${m.addr}_${output?1:0}_${index}" type="number" min="-1" max="39" value="${pin}"></label><label>${uiLang=='de'?'Aktiv':'Enabled'}<select id="fi_en_${m.addr}_${output?1:0}_${index}"><option value="0"${enabled?'':' selected'}>${t('off')}</option><option value="1"${enabled?' selected':''}>${t('on')}</option></select></label><label>${uiLang=='de'?'Pegel':'Polarity'}<select id="fi_low_${m.addr}_${output?1:0}_${index}"><option value="0"${active?'':' selected'}>High</option><option value="1"${active?' selected':''}>Low</option></select></label>${output?'':`<label>Pull<select id="fi_pull_${m.addr}_0_${index}"><option value="0"${pull=='none'?' selected':''}>None</option><option value="1"${pull=='up'?' selected':''}>Up</option><option value="2"${pull=='down'?' selected':''}>Down</option></select></label>`}<button class="secondary" onclick="fanIoSaveChannel(${m.addr},${output?1:0},${index})">${uiLang=='de'?'Ãœbernehmen':'Apply'}</button></div>`}
function fanIoHardwareCard(m){let fan=fanIoDef(m,60),power=fanIoDef(m,61),rpm=fanIoDef(m,62),fm=Number(fanIoDescriptorHeader(m,'filter_mode','0')),pt=Number(fanIoDescriptorHeader(m,'pressure_type','0')),pa=fanIoPin(fanIoDescriptorHeader(m,'pressure_pin_a','-1')),pb=fanIoPin(fanIoDescriptorHeader(m,'pressure_pin_b','-1')),ia=Number(fanIoDescriptorHeader(m,'pressure_i2c_address','33')),life=Number(fanIoDescriptorHeader(m,'filter_lifetime_minutes','60000')),pwmHz=Math.max(10,Math.min(30000,Number(fanIoDescriptorHeader(m,'fan_pwm_frequency_hz',power&&power.meta&&power.meta.pwm_hz?power.meta.pwm_hz:'1000'))||1000)),pwmUnit=pwmHz>=1000?'khz':'hz',pwmValue=pwmUnit=='khz'?Number((pwmHz/1000).toFixed(3)):Math.round(pwmHz);let rows='';for(let i=0;i<8;i++)rows+=fanIoChannelRow(m,false,i);for(let i=0;i<8;i++)rows+=fanIoChannelRow(m,true,i);let filter=m.type==3?`<details><summary>${uiLang=='de'?'FilterÃ¼berwachung':'Filter monitoring'}</summary><div class="cal-grid"><label>${uiLang=='de'?'Auswertung':'Evaluation'}<select id="fi_filter_mode_${m.addr}"><option value="0"${fm==0?' selected':''}>${uiLang=='de'?'Aus':'Off'}</option><option value="1"${fm==1?' selected':''}>${uiLang=='de'?'Nur Laufzeit':'Runtime only'}</option><option value="2"${fm==2?' selected':''}>${uiLang=='de'?'Nur Drucksensor':'Pressure sensor only'}</option><option value="3"${fm==3?' selected':''}>${uiLang=='de'?'Laufzeit + Drucksensor':'Runtime + pressure sensor'}</option></select></label><label>${uiLang=='de'?'Sensortyp':'Sensor type'}<select id="fi_sensor_${m.addr}"><option value="0"${pt==0?' selected':''}>${uiLang=='de'?'Keiner':'None'}</option><option value="1"${pt==1?' selected':''}>Analog</option><option value="2"${pt==2?' selected':''}>SDP3x I2C</option></select></label><label>GPIO / SDA<input id="fi_pa_${m.addr}" type="number" min="-1" max="39" value="${pa}"></label><label>SCL<input id="fi_pb_${m.addr}" type="number" min="-1" max="39" value="${pb}"></label><label>I2C address<input id="fi_i2c_${m.addr}" type="number" min="8" max="119" value="${ia}"></label><label>${uiLang=='de'?'Filter-Wechselintervall (min)':'Filter replacement interval (min)'}<input id="fi_life_${m.addr}" type="number" min="1" max="1000000" value="${life}"></label><button onclick="fanIoSaveFilter(${m.addr})">${uiLang=='de'?'Ãœbernehmen':'Apply'}</button></div></details>`:'';return `<div class="tile module-card fan-card core-style"><div class="module-head"><div class="module-title">${mn(m)} Â· ${uiLang=='de'?'Hardware':'Hardware'}</div><div class="module-address">${hx(m.addr)}</div></div><div class="universal-entities is-main"><div class="uni-section-title"><div class="k">${uiLang=='de'?'ZusÃ¤tzliche KanÃ¤le':'Additional channels'}</div><small>Descriptor</small></div><div id="uni_entities_${m.addr}" class="universal-entities-list"></div></div><details><summary>${uiLang=='de'?'GPIO-Konfiguration':'GPIO configuration'}</summary><div class="cal-grid"><label>Enable GPIO<input id="fi_fen_${m.addr}" type="number" min="-1" max="39" value="${fanIoPin(fan&&fan.meta.gpio)}"></label><label>PWM GPIO<input id="fi_fpwm_${m.addr}" type="number" min="-1" max="39" value="${fanIoPin(power&&power.meta.gpio)}"></label><label>${uiLang=='de'?'PWM-Frequenz':'PWM frequency'}<input id="fi_pfreq_${m.addr}" type="number" min="${pwmUnit=='khz'?0.01:10}" max="${pwmUnit=='khz'?30:30000}" step="${pwmUnit=='khz'?0.001:1}" value="${pwmValue}" data-unit="${pwmUnit}"></label><label>${uiLang=='de'?'Einheit':'Unit'}<select id="fi_pfreq_unit_${m.addr}" onchange="fanIoLegacyPwmUnitSet(${m.addr},this.value)"><option value="hz"${pwmUnit=='hz'?' selected':''}>Hz</option><option value="khz"${pwmUnit=='khz'?' selected':''}>kHz</option></select></label><label>Tacho GPIO<input id="fi_ftacho_${m.addr}" type="number" min="-1" max="39" value="${fanIoPin(rpm&&rpm.meta.gpio)}"></label><label>${uiLang=='de'?'Impulse/Umdrehung':'Pulses/revolution'}<input id="fi_ppr_${m.addr}" type="number" min="1" max="16" value="${Number(rpm&&rpm.meta.ppr||2)}"></label><button onclick="fanIoSaveFan(${m.addr})">${uiLang=='de'?'LÃ¼fter Ã¼bernehmen':'Apply fan'}</button></div>${filter}<details><summary>${uiLang=='de'?'Ein- und AusgÃ¤nge':'Inputs and outputs'}</summary>${rows}</details><button class="secondary danger" onclick="fanIoResetConfig(${m.addr})">${uiLang=='de'?'GPIO auf Standard zurÃ¼cksetzen':'Reset GPIO defaults'}</button><div id="fi_msg_${m.addr}" class="uni-save-state"></div></details></div>`}
function fanIoHardwareEditor(m){let holder=document.createElement('div');holder.innerHTML=fanIoHardwareCard(m);let card=holder.firstElementChild;if(!card)return '';let head=card.querySelector('.module-head');if(head)head.remove();let root=Array.from(card.children).find(e=>e.tagName=='DETAILS');if(root){root.classList.add('universal-profile','fanio-gpio-editor');let summary=root.firstElementChild,body=document.createElement('div');body.className='fanio-editor-body';while(summary&&summary.nextSibling)body.appendChild(summary.nextSibling);root.appendChild(body);body.querySelectorAll('details').forEach(e=>e.classList.add('fanio-editor-section'))}return `<div class="fanio-integrated-editor">${card.innerHTML}</div>`}
var fanIoEditorDraft=null;
const fanIoReservedPins={0:'Boot/Strapping',1:'USB/UART',2:'System',3:'USB/UART',4:'OFE/EVT Status-LEDs',5:'System/Flash',6:'Flash',7:'Flash',8:'Flash',9:'Flash',10:'Flash',11:'System/Flash',12:'Strapping',15:'System',25:'OFE-Bus TX',26:'OFE-Bus RX'};
function fanIoEditorState(m){
  let channel=(output,index)=>{let d=fanIoDef(m,(output?40:20)+index),meta=d?d.meta:{};return {enabled:!!d,wasEnabled:!!d,name:d?(d.label||d.key):((output?'OUT':'IN')+(index+1)),pin:fanIoPin(meta.gpio),activeLow:Number(meta.active_low||0)>0,pull:String(meta.pull||'none').toLowerCase()}};
  let fan=fanIoDef(m,60),power=fanIoDef(m,61),rpm=fanIoDef(m,62),enablePin=fanIoPin(fan&&fan.meta.gpio),pwmPin=fanIoPin(power&&power.meta.gpio);
  let modeRaw=fanIoDescriptorHeader(m,'fan_output_mode','');
  let outputMode=modeRaw===''?(enablePin>=0&&pwmPin>=0?2:(pwmPin>=0?1:0)):Math.max(0,Math.min(2,Number(modeRaw)));
  let legacyLow=Number(fanIoDescriptorHeader(m,'fan_active_low','0'))>0;
  let pwmHz=Number(fanIoDescriptorHeader(m,'fan_pwm_frequency_hz',power&&power.meta&&power.meta.pwm_hz?power.meta.pwm_hz:'1000'));
  if(!Number.isFinite(pwmHz)||pwmHz<10||pwmHz>30000)pwmHz=1000;pwmHz=Math.round(pwmHz);
  let minPower=Math.max(1,Math.min(100,Number(fanIoDescriptorHeader(m,'fan_min_power',power&&power.meta&&power.meta.min?power.meta.min:'10'))||10));
  let maxPower=Math.max(1,Math.min(100,Number(fanIoDescriptorHeader(m,'fan_max_power',power&&power.meta&&power.meta.max?power.meta.max:'100'))||100));
  if(maxPower<minPower)maxPower=minPower;
  return {addr:Number(m.addr),uid:String(m.uid||''),title:mn(m),pro:Number(m.type)==3,
    inputs:Array.from({length:8},(_,i)=>channel(false,i)),outputs:Array.from({length:8},(_,i)=>channel(true,i)),
    fan:{enabled:Number(fanIoDescriptorHeader(m,'fan_enabled',(enablePin>=0||pwmPin>=0)?'1':'0'))>0,name:(fan&&(fan.label||fan.key))||m.io_main_alias||(uiLang=='de'?'LÃ¼fter':'Fan'),outputMode,
      enablePin,pwmPin,tachoPin:fanIoPin(rpm&&rpm.meta.gpio),relayActiveLow:Number(fanIoDescriptorHeader(m,'fan_enable_active_low',legacyLow?'1':'0'))>0,
      pwmActiveLow:Number(fanIoDescriptorHeader(m,'fan_pwm_active_low',legacyLow?'1':'0'))>0,pwmOpenDrain:Number(fanIoDescriptorHeader(m,'fan_pwm_open_drain','0'))>0,
      minPower,maxPower,ppr:Math.max(1,Math.min(16,Number(rpm&&rpm.meta.ppr||2))),pwmFrequencyHz:pwmHz,pwmFrequencyUnit:pwmHz>=1000?'khz':'hz'},
    filter:{mode:Math.max(0,Math.min(3,Number(fanIoDescriptorHeader(m,'filter_mode','0')))),sensor:Math.max(0,Math.min(2,Number(fanIoDescriptorHeader(m,'pressure_type','0')))),pinA:fanIoPin(fanIoDescriptorHeader(m,'pressure_pin_a','-1')),pinB:fanIoPin(fanIoDescriptorHeader(m,'pressure_pin_b','-1')),i2c:Math.max(8,Math.min(119,Number(fanIoDescriptorHeader(m,'pressure_i2c_address','33')))),lifetime:Math.max(1,Math.min(1000000,Number(fanIoDescriptorHeader(m,'filter_lifetime_minutes','60000'))))}};
}
function fanIoPinAllowed(pin,output){if(pin<0||pin>39||fanIoReservedPins[pin])return false;return !output||pin<=33}
function fanIoPinUses(){let d=fanIoEditorDraft,uses={};if(!d)return uses;let add=(pin,key,label)=>{pin=Number(pin);if(pin>=0)(uses[pin]||(uses[pin]=[])).push({key,label})};d.inputs.forEach((c,i)=>{if(c.enabled)add(c.pin,'in'+i,(uiLang=='de'?'Eingang ':'Input ')+(i+1)+' Â· '+c.name)});d.outputs.forEach((c,i)=>{if(c.enabled)add(c.pin,'out'+i,(uiLang=='de'?'Ausgang ':'Output ')+(i+1)+' Â· '+c.name)});if(d.fan.enabled){let usesRelay=d.fan.outputMode==0||d.fan.outputMode==2,usesPwm=d.fan.outputMode==1||d.fan.outputMode==2;if(usesRelay)add(d.fan.enablePin,'fan_enable',uiLang=='de'?'Relaisausgang':'Relay output');if(usesPwm)add(d.fan.pwmPin,'fan_pwm',uiLang=='de'?'LÃ¼fter PWM':'Fan PWM');add(d.fan.tachoPin,'fan_tacho',uiLang=='de'?'DrehzahlrÃ¼ckmeldung':'Tach feedback')}let pressure=d.pro&&(d.filter.mode==2||d.filter.mode==3);if(pressure&&d.filter.sensor==1)add(d.filter.pinA,'filter_a',uiLang=='de'?'Drucksensor analog':'Analog pressure sensor');if(pressure&&d.filter.sensor==2){add(d.filter.pinA,'filter_a','Drucksensor SDA');add(d.filter.pinB,'filter_b','Drucksensor SCL')}return uses}
function fanIoPinOptions(current,output,owner){current=fanIoPin(current);let uses=fanIoPinUses(),html=`<option value="-1"${current<0?' selected':''}>${uiLang=='de'?'Nicht verwendet':'Not used'}</option>`;for(let pin=0;pin<=39;pin++){let reason=fanIoReservedPins[pin]||(!fanIoPinAllowed(pin,output)?(output&&pin>=34?(uiLang=='de'?'nur als Eingang nutzbar':'input only'):(uiLang=='de'?'nicht verfÃ¼gbar':'unavailable')):''),note=!output&&pin>=34&&pin<=39?(uiLang=='de'?'kein interner Pull-up/down Â· externer Widerstand nÃ¶tig':'no internal pull-up/down Â· external resistor required'):'';let foreign=(uses[pin]||[]).filter(x=>x.key!=owner);if(foreign.length)reason=(uiLang=='de'?'belegt: ':'used by: ')+foreign.map(x=>x.label).join(', ');let disabled=!!reason&&pin!==current,label='GPIO '+pin+((reason||note)?' Â· '+(reason||note):'');html+=`<option value="${pin}"${pin===current?' selected':''}${disabled?' disabled':''} title="${escAttr(reason||note||label)}">${escHtml(label)}</option>`}return html}
function fanIoEditorChannelHtml(output,index,c){let group=output?'outputs':'inputs',owner=(output?'out':'in')+index,kind=output?(uiLang=='de'?'Ausgang':'Output'):(uiLang=='de'?'Eingang':'Input');return `<div class="fanio-channel ${output?'is-output':'is-input'}"><label><span class="fanio-channel-index">${kind} ${index+1}</span><input maxlength="18" value="${escAttr(c.name)}" oninput="fanIoEditorDraft.${group}[${index}].name=this.value"></label><label>GPIO<select onchange="fanIoEditorDraft.${group}[${index}].pin=Number(this.value);fanIoEditorRender()">${fanIoPinOptions(c.pin,output,owner)}</select></label><label>${uiLang=='de'?'Aktiver Pegel':'Active level'}<select onchange="fanIoEditorDraft.${group}[${index}].activeLow=this.value=='1'"><option value="0"${c.activeLow?'':' selected'}>High</option><option value="1"${c.activeLow?' selected':''}>Low</option></select></label>${output?'':`<label>Pull<select onchange="fanIoEditorDraft.inputs[${index}].pull=this.value"><option value="none"${c.pull=='none'?' selected':''}>None</option><option value="up"${c.pull=='up'?' selected':''}>Up</option><option value="down"${c.pull=='down'?' selected':''}>Down</option></select></label>`}<button class="secondary danger fanio-channel-remove" title="${uiLang=='de'?'Kanal lÃ¶schen':'Delete channel'}" onclick="fanIoEditorRemove(${output?1:0},${index})">&#215;</button></div>`}
function fanIoEditorAdd(output){if(!fanIoEditorDraft)return;let list=output?fanIoEditorDraft.outputs:fanIoEditorDraft.inputs,index=list.findIndex(c=>!c.enabled);if(index<0){fanIoEditorMessage(uiLang=='de'?'Es sind bereits alle acht PlÃ¤tze belegt.':'All eight slots are already used.',true);return}let c=list[index];c.enabled=true;c.name=(output?'OUT':'IN')+(index+1);c.pin=-1;c.activeLow=false;c.pull='none';fanIoEditorRender()}
function fanIoEditorRemove(output,index){if(!fanIoEditorDraft)return;let c=(output?fanIoEditorDraft.outputs:fanIoEditorDraft.inputs)[index];c.enabled=false;c.pin=-1;fanIoEditorRender()}
function fanIoEditorMessage(text,error=false,ok=false){let e=document.getElementById('fanio_editor_message');if(!e)return;e.textContent=text||'';e.className='fanio-editor-message'+(error?' is-error':(ok?' is-ok':''))}
function fanIoEditorLifetimeSet(part,value){
  if(!fanIoEditorDraft)return;
  let total=Math.max(1,Math.floor(Number(fanIoEditorDraft.filter.lifetime)||1));
  let days=Math.floor(total/1440),hours=Math.floor((total%1440)/60),minutes=total%60;
  value=Math.max(0,Math.floor(Number(value)||0));
  if(part=='days')days=Math.min(694,value);
  if(part=='hours')hours=Math.min(23,value);
  if(part=='minutes')minutes=Math.min(59,value);
  fanIoEditorDraft.filter.lifetime=Math.max(1,Math.min(1000000,days*1440+hours*60+minutes));
}
function fanIoEditorPwmFrequencySet(value){
  if(!fanIoEditorDraft)return;
  let v=Number(value),unit=fanIoEditorDraft.fan.pwmFrequencyUnit;
  if(!Number.isFinite(v))return;
  fanIoEditorDraft.fan.pwmFrequencyHz=Math.round(unit=='khz'?v*1000:v);
}
function fanIoEditorPwmUnitSet(unit){
  if(!fanIoEditorDraft)return;
  fanIoEditorDraft.fan.pwmFrequencyUnit=unit=='khz'?'khz':'hz';
  fanIoEditorRender();
}
function fanIoEditorRender(){
  let d=fanIoEditorDraft,box=document.getElementById('fanio_editor_scroll');
  if(!d||!box)return;
  let inputs=d.inputs.map((c,i)=>c.enabled?fanIoEditorChannelHtml(false,i,c):'').join('');
  let outputs=d.outputs.map((c,i)=>c.enabled?fanIoEditorChannelHtml(true,i,c):'').join('');
  let pressure=d.pro&&(d.filter.mode==2||d.filter.mode==3),runtime=d.pro&&(d.filter.mode==1||d.filter.mode==3);
  let lifetime=Math.max(1,Math.floor(Number(d.filter.lifetime)||1)),lifeDays=Math.floor(lifetime/1440),lifeHours=Math.floor((lifetime%1440)/60),lifeMinutes=lifetime%60;
  let pwmUnit=d.fan.pwmFrequencyUnit=='khz'?'khz':'hz',pwmHz=Number(d.fan.pwmFrequencyHz);if(!Number.isFinite(pwmHz))pwmHz=1000;
  let pwmValue=pwmUnit=='khz'?Number((pwmHz/1000).toFixed(3)):Math.round(pwmHz),pwmMin=pwmUnit=='khz'?0.01:10,pwmMax=pwmUnit=='khz'?30:30000,pwmStep=pwmUnit=='khz'?0.001:1;
  let usesRelay=d.fan.outputMode==0||d.fan.outputMode==2,usesPwm=d.fan.outputMode==1||d.fan.outputMode==2,fanOn=!!d.fan.enabled;
  let filter=d.pro?`<section class="fanio-editor-panel is-wide"><div class="fanio-editor-panel-head"><h3>${uiLang=='de'?'FilterÃ¼berwachung':'Filter monitoring'}</h3></div><div class="fanio-field-grid"><label>${uiLang=='de'?'Auswertung':'Evaluation'}<select onchange="fanIoEditorDraft.filter.mode=Number(this.value);fanIoEditorRender()"><option value="0"${d.filter.mode==0?' selected':''}>${uiLang=='de'?'Aus':'Off'}</option><option value="1"${d.filter.mode==1?' selected':''}>${uiLang=='de'?'Nur Laufzeit':'Runtime only'}</option><option value="2"${d.filter.mode==2?' selected':''}>${uiLang=='de'?'Nur Drucksensor':'Pressure sensor only'}</option><option value="3"${d.filter.mode==3?' selected':''}>${uiLang=='de'?'Laufzeit + Drucksensor':'Runtime + pressure sensor'}</option></select></label><label>${uiLang=='de'?'Sensortyp':'Sensor type'}<select ${pressure?'':'disabled'} onchange="fanIoEditorDraft.filter.sensor=Number(this.value);fanIoEditorRender()"><option value="0"${d.filter.sensor==0?' selected':''}>${uiLang=='de'?'Keiner':'None'}</option><option value="1"${d.filter.sensor==1?' selected':''}>Analog</option><option value="2"${d.filter.sensor==2?' selected':''}>SDP3x I2C</option></select></label>${pressure&&d.filter.sensor?`<label>${d.filter.sensor==2?'SDA':'GPIO'}<select onchange="fanIoEditorDraft.filter.pinA=Number(this.value);fanIoEditorRender()">${fanIoPinOptions(d.filter.pinA,d.filter.sensor==2,'filter_a')}</select></label>`:''}${pressure&&d.filter.sensor==2?`<label>SCL<select onchange="fanIoEditorDraft.filter.pinB=Number(this.value);fanIoEditorRender()">${fanIoPinOptions(d.filter.pinB,true,'filter_b')}</select></label><label>I2C address<input type="number" min="8" max="119" value="${d.filter.i2c}" onchange="fanIoEditorDraft.filter.i2c=Number(this.value)"></label>`:''}${runtime?`<label>${uiLang=='de'?'Filter-Wechselintervall Â· Tage':'Filter replacement interval Â· days'}<input type="number" min="0" max="694" value="${lifeDays}" onchange="fanIoEditorLifetimeSet('days',this.value)"></label><label>${uiLang=='de'?'Stunden':'Hours'}<input type="number" min="0" max="23" value="${lifeHours}" onchange="fanIoEditorLifetimeSet('hours',this.value)"></label><label>${uiLang=='de'?'Minuten':'Minutes'}<input type="number" min="0" max="59" value="${lifeMinutes}" onchange="fanIoEditorLifetimeSet('minutes',this.value)"></label>`:''}</div></section>`:'';
  let relayFields=usesRelay?`<label>${uiLang=='de'?'Relais GPIO':'Relay GPIO'}<select ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.enablePin=Number(this.value);fanIoEditorRender()">${fanIoPinOptions(d.fan.enablePin,true,'fan_enable')}</select></label><label>${uiLang=='de'?'Relais aktiver Pegel':'Relay active level'}<select ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.relayActiveLow=this.value=='1'"><option value="0"${d.fan.relayActiveLow?'':' selected'}>High</option><option value="1"${d.fan.relayActiveLow?' selected':''}>Low</option></select></label>`:'';
  let pwmFields=usesPwm?`<label>PWM GPIO<select ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.pwmPin=Number(this.value);fanIoEditorRender()">${fanIoPinOptions(d.fan.pwmPin,true,'fan_pwm')}</select></label><label>${uiLang=='de'?'PWM aktiver Pegel':'PWM active level'}<select ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.pwmActiveLow=this.value=='1'"><option value="0"${d.fan.pwmActiveLow?'':' selected'}>High</option><option value="1"${d.fan.pwmActiveLow?' selected':''}>Low</option></select></label><label>${uiLang=='de'?'PWM Ausgang':'PWM output'}<select ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.pwmOpenDrain=this.value=='1'"><option value="0"${d.fan.pwmOpenDrain?'':' selected'}>Push-Pull</option><option value="1"${d.fan.pwmOpenDrain?' selected':''}>Open-Drain</option></select></label><label>${uiLang=='de'?'PWM-Frequenz':'PWM frequency'}<input type="number" min="${pwmMin}" max="${pwmMax}" step="${pwmStep}" value="${pwmValue}" ${fanOn?'':'disabled'} onchange="fanIoEditorPwmFrequencySet(this.value)"></label><label>${uiLang=='de'?'Frequenzeinheit':'Frequency unit'}<select ${fanOn?'':'disabled'} onchange="fanIoEditorPwmUnitSet(this.value)"><option value="hz"${pwmUnit=='hz'?' selected':''}>Hz</option><option value="khz"${pwmUnit=='khz'?' selected':''}>kHz</option></select></label><label>${uiLang=='de'?'Mindestleistung':'Minimum power'} (%)<input type="number" min="1" max="100" step="1" value="${d.fan.minPower}" ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.minPower=Number(this.value)"></label><label>${uiLang=='de'?'Maximalleistung':'Maximum power'} (%)<input type="number" min="1" max="100" step="1" value="${d.fan.maxPower}" ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.maxPower=Number(this.value)"></label>`:'';
  box.innerHTML=`<div class="fanio-editor-grid"><section class="fanio-editor-panel is-wide"><div class="fanio-editor-panel-head"><h3>${uiLang=='de'?'Absaugung / LÃ¼fter':'Extraction / fan'}</h3></div><div class="fanio-field-grid"><label>${uiLang=='de'?'Alias':'Alias'}<input maxlength="18" value="${escAttr(d.fan.name)}" oninput="fanIoEditorDraft.fan.name=this.value"></label><label>${uiLang=='de'?'Hauptausgang':'Main output'}<select onchange="fanIoEditorDraft.fan.enabled=this.value=='1';fanIoEditorRender()"><option value="1"${fanOn?' selected':''}>${t('on')}</option><option value="0"${fanOn?'':' selected'}>${t('off')}</option></select></label><label>${uiLang=='de'?'Ausgangsart':'Output type'}<select ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.outputMode=Number(this.value);fanIoEditorRender()"><option value="0"${d.fan.outputMode==0?' selected':''}>${uiLang=='de'?'Relais':'Relay'}</option><option value="1"${d.fan.outputMode==1?' selected':''}>PWM</option><option value="2"${d.fan.outputMode==2?' selected':''}>${uiLang=='de'?'Relais + PWM':'Relay + PWM'}</option></select></label>${relayFields}${pwmFields}<label>Tacho GPIO<select ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.tachoPin=Number(this.value);fanIoEditorRender()">${fanIoPinOptions(d.fan.tachoPin,false,'fan_tacho')}</select></label><label>${uiLang=='de'?'Impulse/Umdrehung':'Pulses/revolution'}<input type="number" min="1" max="16" value="${d.fan.ppr}" ${fanOn?'':'disabled'} onchange="fanIoEditorDraft.fan.ppr=Number(this.value)"></label></div><div class="fanio-pin-help">${uiLang=='de'?'Relais und PWM besitzen getrennte aktive Pegel. Open-Drain ist besonders fÃ¼r externe PWM-EingÃ¤nge bzw. 4-Pin-LÃ¼fter geeignet. PWM: 10 Hz bis 30 kHz. Bei Relais-only ist der Hauptausgang rein Ein/Aus.':'Relay and PWM use separate active levels. Open-drain is useful for external PWM inputs and 4-pin fans. PWM: 10 Hz to 30 kHz. Relay-only is strictly on/off.'}</div></section><section class="fanio-editor-panel is-wide"><div class="fanio-editor-panel-head"><h3>${uiLang=='de'?'EingÃ¤nge':'Inputs'}</h3><button class="secondary" onclick="fanIoEditorAdd(0)">+ ${uiLang=='de'?'Eingang':'Input'}</button></div><div class="fanio-channel-list">${inputs||`<div class="fanio-empty">${uiLang=='de'?'Keine EingÃ¤nge angelegt':'No inputs configured'}</div>`}</div></section><section class="fanio-editor-panel is-wide"><div class="fanio-editor-panel-head"><h3>${uiLang=='de'?'AusgÃ¤nge':'Outputs'}</h3><button class="secondary" onclick="fanIoEditorAdd(1)">+ ${uiLang=='de'?'Ausgang':'Output'}</button></div><div class="fanio-channel-list">${outputs||`<div class="fanio-empty">${uiLang=='de'?'Keine AusgÃ¤nge angelegt':'No outputs configured'}</div>`}</div></section>${filter}</div>`;
}
function fanIoEditorOpen(addr){let m=(window.lastState&&window.lastState.modules||[]).find(x=>Number(x.addr)==Number(addr));if(!m)return;fanIoEditorDraft=fanIoEditorState(m);let old=document.getElementById('fanio_editor_modal');if(old)old.remove();document.body.insertAdjacentHTML('beforeend',`<div id="fanio_editor_modal" class="fanio-editor-modal" onclick="if(event.target===this)fanIoEditorClose()"><div class="fanio-editor-shell"><div class="fanio-editor-head"><div><h2>${escHtml(fanIoEditorDraft.title)} Â· ${uiLang=='de'?'Hardware-Editor':'Hardware editor'}</h2><small>${hx(addr)} Â· ${uiLang=='de'?'GPIO, Aliase, LÃ¼fter und Sensoren':'GPIO, aliases, fan and sensors'}</small></div><button class="secondary fanio-editor-close" title="${uiLang=='de'?'SchlieÃŸen':'Close'}" onclick="fanIoEditorClose()">&#215;</button></div><div id="fanio_editor_scroll" class="fanio-editor-scroll"></div><div class="fanio-editor-foot"><div id="fanio_editor_message" class="fanio-editor-message"></div><div class="fanio-editor-actions"><button class="secondary danger" onclick="fanIoEditorReset()">${uiLang=='de'?'Werkseinstellungen':'Defaults'}</button><button id="fanio_editor_save" onclick="fanIoEditorSave()">${uiLang=='de'?'Ins Modul speichern':'Save to module'}</button></div></div></div></div>`);document.body.style.overflow='hidden';fanIoEditorRender()}
function fanIoEditorClose(){let e=document.getElementById('fanio_editor_modal');if(e)e.remove();document.body.style.overflow='';fanIoEditorDraft=null}
function fanIoEditorCard(m){return `<div class="fanio-card-tools universal-card"><div class="universal-entities is-main"><div class="uni-section-title"><div class="k">${uiLang=='de'?'Konfigurierte Ein- / AusgÃ¤nge':'Configured inputs / outputs'}</div><small>GPIO</small></div><div id="uni_entities_${m.addr}" class="universal-entities-list"></div></div><button type="button" class="modbus-builder-launch fanio-gpio-builder-launch" onclick="fanIoEditorOpen(${m.addr})"><span class="modbus-builder-launch-copy"><strong>${uiLang=='de'?'GPIO Hardware-Editor':'GPIO Hardware Editor'}</strong><small>${uiLang=='de'?'KanÃ¤le hinzufÃ¼gen oder lÃ¶schen, Aliase und GPIOs festlegen':'Add or remove channels, assign aliases and GPIOs'}</small></span><span class="modbus-builder-launch-open">${uiLang=='de'?'Editor Ã¶ffnen':'Open editor'} â†—</span></button></div>`}
function renderFanIoEntities(m){let box=document.getElementById('uni_entities_'+m.addr);if(!box)return;let cache=universalDescriptorCache[m.addr];if((!m.universal_descriptor||!m.universal_descriptor.length)&&cache&&Number(cache.crc)===Number(m.universal_descriptor_crc))m.universal_descriptor=cache.text;else if(m.universal_descriptor&&m.universal_descriptor.length)universalDescriptorCache[m.addr]={crc:Number(m.universal_descriptor_crc),text:m.universal_descriptor};let defs=universalDefsForModule(m).filter(d=>Number(d.id)>=20&&Number(d.id)<48),sig=[m.addr,uiLang,m.universal_descriptor_crc,defs.length,universalDefsSignature(defs)].join('|');if(box.dataset.sig!==sig){box.dataset.sig=sig;universalRenderList(m,defs,'uni_entities_'+m.addr,'GPIO',uiLang=='de'?'Keine Ein- oder AusgÃ¤nge konfiguriert.':'No inputs or outputs configured.')}defs.forEach(d=>{let st=universalEntityState(m,d.id);universalUpdateEntity(m,d,st);let id=Number(d.id);if(id>=20&&id<28&&d.type=='binary_sensor')fanIoInputState('uni_ent_val_'+m.addr+'_'+d.id,!!(st&&st.value_bool),!!(st&&typeof st.value_bool!=='undefined'))})}
function fanIoConfigBody(kind,fields={}){if(kind=='filter'&&Number(fields.mode)!=2&&Number(fields.mode)!=3)fields={...fields,sensor:0,pin_a:-1,pin_b:-1};if(kind=='fan'&&!Number(fields.enabled))fields={...fields,enable_pin:-1,pwm_pin:-1,tacho_pin:-1};let b=new URLSearchParams();b.set('addr',fanIoEditorDraft.addr);b.set('kind',kind);Object.keys(fields).forEach(k=>b.set(k,fields[k]));return b}
async function fanIoEditorRequest(body,finalize=false){if(!finalize)body.set('defer','1');let r=await fetch('/module/io_config',{method:'POST',body,cache:'no-store'}),text=await r.text();if(!r.ok)throw new Error(text||'I/O configuration failed')}
function fanIoEditorValidate(){
  let d=fanIoEditorDraft,used={},take=(pin,output,label,required=true)=>{pin=Number(pin);if(pin<0){if(required)throw new Error(label+': '+(uiLang=='de'?'GPIO fehlt':'GPIO is missing'));return}if(!fanIoPinAllowed(pin,output))throw new Error('GPIO '+pin+': '+(uiLang=='de'?'nicht verfÃ¼gbar':'unavailable'));if(used[pin])throw new Error('GPIO '+pin+': '+(uiLang=='de'?'doppelt belegt durch ':'assigned twice by ')+used[pin]+' / '+label);used[pin]=label};
  d.inputs.forEach((c,i)=>{if(c.enabled){c.name=c.name.trim();if(!c.name)throw new Error((uiLang=='de'?'Eingang ':'Input ')+(i+1)+': Alias fehlt');take(c.pin,false,c.name)}});
  d.outputs.forEach((c,i)=>{if(c.enabled){c.name=c.name.trim();if(!c.name)throw new Error((uiLang=='de'?'Ausgang ':'Output ')+(i+1)+': Alias fehlt');take(c.pin,true,c.name)}});
  d.fan.name=d.fan.name.trim();if(!d.fan.name)d.fan.name=uiLang=='de'?'LÃ¼fter':'Fan';
  d.fan.outputMode=Math.max(0,Math.min(2,Number(d.fan.outputMode)||0));let usesRelay=d.fan.outputMode==0||d.fan.outputMode==2,usesPwm=d.fan.outputMode==1||d.fan.outputMode==2;
  if(d.fan.enabled){if(usesRelay)take(d.fan.enablePin,true,uiLang=='de'?'Relaisausgang':'Relay output');if(usesPwm)take(d.fan.pwmPin,true,'PWM');take(d.fan.tachoPin,false,'Tacho',false)}
  if(d.fan.ppr<1||d.fan.ppr>16)throw new Error(uiLang=='de'?'Impulse/Umdrehung mÃ¼ssen zwischen 1 und 16 liegen.':'Pulses/revolution must be between 1 and 16.');
  let pwmHz=Math.round(Number(d.fan.pwmFrequencyHz));if(!Number.isFinite(pwmHz)||pwmHz<10||pwmHz>30000)throw new Error(uiLang=='de'?'Die PWM-Frequenz muss zwischen 10 Hz und 30 kHz liegen.':'PWM frequency must be between 10 Hz and 30 kHz.');d.fan.pwmFrequencyHz=pwmHz;
  d.fan.minPower=Math.round(Number(d.fan.minPower));d.fan.maxPower=Math.round(Number(d.fan.maxPower));if(d.fan.minPower<1||d.fan.minPower>100||d.fan.maxPower<1||d.fan.maxPower>100||d.fan.minPower>d.fan.maxPower)throw new Error(uiLang=='de'?'Mindest-/Maximalleistung mÃ¼ssen zwischen 1 und 100 % liegen; Minimum darf nicht grÃ¶ÃŸer als Maximum sein.':'Minimum/maximum power must be 1..100%; minimum cannot exceed maximum.');
  if(d.pro&&(d.filter.mode==2||d.filter.mode==3)){if(!d.filter.sensor)throw new Error(uiLang=='de'?'FÃ¼r die Druckauswertung muss ein Sensortyp gewÃ¤hlt werden.':'Select a sensor type for pressure evaluation.');take(d.filter.pinA,d.filter.sensor==2,'Drucksensor GPIO/SDA');if(d.filter.sensor==2)take(d.filter.pinB,true,'Drucksensor SCL')}
  if(d.pro&&(d.filter.lifetime<1||d.filter.lifetime>1000000))throw new Error(uiLang=='de'?'Das Filter-Wechselintervall muss zwischen 1 und 1000000 Minuten liegen.':'Filter replacement interval must be between 1 and 1000000 minutes.');
}
async function fanIoEditorSave(){
  let d=fanIoEditorDraft;if(!d)return;
  try{fanIoEditorValidate()}catch(e){fanIoEditorMessage(e.message,true);return}
  let save=document.getElementById('fanio_editor_save');if(save)save.disabled=true;
  let channelCount=d.inputs.filter(c=>c.wasEnabled||c.enabled).length+d.outputs.filter(c=>c.wasEnabled||c.enabled).length;
  let total=1+channelCount+1+(d.pro?1:0)+1,done=0,transaction=false;
  let progress=()=>fanIoEditorMessage((uiLang=='de'?'Wird sicher gespeichert ':'Saving safely ')+(++done)+' / '+total+' ...');
  let fanFields=(enabled)=>{let usesRelay=d.fan.outputMode==0||d.fan.outputMode==2,usesPwm=d.fan.outputMode==1||d.fan.outputMode==2;return {enable_pin:enabled&&usesRelay?d.fan.enablePin:-1,pwm_pin:enabled&&usesPwm?d.fan.pwmPin:-1,tacho_pin:enabled?d.fan.tachoPin:-1,enabled:enabled?1:0,active_low:d.fan.relayActiveLow?1:0,relay_active_low:d.fan.relayActiveLow?1:0,pwm_active_low:d.fan.pwmActiveLow?1:0,pwm_open_drain:d.fan.pwmOpenDrain?1:0,output_mode:d.fan.outputMode,min_power:d.fan.minPower,max_power:d.fan.maxPower,ppr:d.fan.ppr,pwm_freq_hz:d.fan.pwmFrequencyHz}};
  try{
    await fanIoEditorRequest(fanIoConfigBody('begin'));transaction=true;progress();
    // All channel changes now go only into the module's RAM transaction copy.
    // There is no tear-down phase, so the currently active GPIO map keeps
    // running until the final COMMIT has validated the complete new map.
    for(let output=0;output<=1;output++){let list=output?d.outputs:d.inputs;for(let i=0;i<list.length;i++){let c=list[i];if(!c.wasEnabled&&!c.enabled)continue;await fanIoEditorRequest(fanIoConfigBody('channel',{output,index:i,name:c.name||((output?'OUT':'IN')+(i+1)),pin:c.enabled?c.pin:-1,enabled:c.enabled?1:0,active_low:c.activeLow?1:0,pull:output?0:(c.pull=='up'?1:(c.pull=='down'?2:0))}));progress()}}
    await fanIoEditorRequest(fanIoConfigBody('fan',fanFields(d.fan.enabled)));progress();
    if(d.pro){await fanIoEditorRequest(fanIoConfigBody('filter',{mode:d.filter.mode,sensor:d.filter.sensor,pin_a:d.filter.pinA,pin_b:d.filter.pinB,i2c_addr:d.filter.i2c,lifetime:d.filter.lifetime}));progress()}
    await fanIoEditorRequest(fanIoConfigBody('commit'),true);transaction=false;progress();
    let alias=new URLSearchParams();alias.set('uid',d.uid);alias.set('addr',d.addr);alias.set('key','main');alias.set('alias',d.fan.name);
    let ar=await fetch('/module/io_alias',{method:'POST',body:alias,cache:'no-store'});if(!ar.ok)throw new Error(await ar.text()||'Alias failed');
    fanIoEditorMessage(uiLang=='de'?'Konfiguration atomar im Modul gespeichert.':'Configuration saved atomically in module.',false,true);delete universalDescriptorCache[d.addr];detailsSig='';routingSig='';await load(true);setTimeout(fanIoEditorClose,500)
  }catch(e){
    if(transaction){try{await fanIoEditorRequest(fanIoConfigBody('abort'),true)}catch(_){}}
    fanIoEditorMessage(e.message||String(e),true);if(save)save.disabled=false
  }
}
async function fanIoEditorReset(){let d=fanIoEditorDraft;if(!d||!confirm(uiLang=='de'?'Wirklich alle GPIOs und KanÃ¤le auf Werkseinstellungen zurÃ¼cksetzen?':'Reset all GPIOs and channels to defaults?'))return;let save=document.getElementById('fanio_editor_save');if(save)save.disabled=true;fanIoEditorMessage(uiLang=='de'?'Werkseinstellungen werden geladen ...':'Loading defaults ...');try{await fanIoEditorRequest(fanIoConfigBody('reset'),true);delete universalDescriptorCache[d.addr];detailsSig='';routingSig='';fanIoEditorClose();setTimeout(()=>load(true),300)}catch(e){fanIoEditorMessage(e.message||String(e),true);if(save)save.disabled=false}}
function renderDetails(d){let det='';(d.modules||[]).forEach(m=>{if(m.type==1){det+=`<div class="tile module-card jbc-card core-style"><div class="module-head"><div class="module-title">${mn(m)}</div><div class="module-head-main"><div class="module-identity"><span class="module-icon">${moduleSerialGlyph()}</span><div class="module-head-copy"><div class="module-type">JBC Bus</div><div class="module-address">${hx(m.addr)}</div></div></div><div class="module-statuses"><span id="jbc_mod_${m.addr}" class="pill">-</span><span id="jbc_conn_${m.addr}" class="pill">-</span></div></div></div><div class="jbu-hero"><div class="jbu-hero-top"><div id="jbc_station_head_${m.addr}" class="jbu-station-name">-</div><div class="jbu-badges"><span class="jbu-chip proto">JBC</span><span class="jbu-chip kind">${uiLang=='de'?'FAE GerÃ¤tebus':'FAE device bus'}</span></div></div></div><div class="jbu-state-grid"><div id="jbc_workbox_${m.addr}" class="jbu-state-card"><div class="jbu-state-symbol"><span class="jbu-work-symbol" aria-label="work">${jbcUsbWorkGlyph()}</span></div><div class="jbu-state-copy"><small>WORK</small><strong id="jbc_work_${m.addr}">-</strong></div></div><div id="jbc_standbox_${m.addr}" class="jbu-state-card is-stand"><div class="jbu-state-symbol"><span class="jbu-stand-symbol">${jbcUsbStandGlyph()}</span></div><div class="jbu-state-copy"><small>STAND</small><strong id="jbc_stand_${m.addr}">-</strong></div></div></div><div class="jbu-facts"><div class="jbu-fact"><div class="k">${t('station')}</div><div id="jbc_station_${m.addr}" class="v">-</div></div><div class="jbu-fact"><div class="k">${uiLang=='de'?'JBC FAE Adresse':'JBC FAE address'}</div><div id="jbc_addr_${m.addr}" class="v mono">-</div></div><div class="jbu-fact is-wide"><div class="k">${t('device_id')} (<span id="jbc_devid_len_${m.addr}">0</span>)</div><div id="jbc_devid_ascii_${m.addr}" class="v mono">-</div></div><div class="jbu-fact"><div class="k">${uiLang=='de'?'Status':'Status'}</div><div id="jbc_flags_${m.addr}" class="v">-</div></div><div class="jbu-fact"><div class="k">Flags raw</div><div id="jbc_flags_raw_${m.addr}" class="v mono">-</div></div></div><details class="jbu-tech dev-only"><summary>${uiLang=='de'?'FAE Emulation Debug Â· OFE â†” FAE â†” JBC':'FAE emulation debug Â· OFE â†” FAE â†” JBC'}</summary><div class="jbu-tech-grid"><div><div class="k">0x38 IntakeActivation</div><strong id="jbc_dbg_output_${m.addr}">-</strong></div><div><div class="k">0x39 WORK Request Mask</div><strong id="jbc_dbg_workmask_${m.addr}">-</strong></div><div><div class="k">STAND Request Mask</div><strong id="jbc_dbg_standmask_${m.addr}">-</strong></div><div><div class="k">0x30 SuctionLevel</div><strong id="jbc_dbg_suction_${m.addr}">-</strong></div><div><div class="k">0x34 SelectFlow</div><strong id="jbc_dbg_flowset_${m.addr}">-</strong></div><div><div class="k">0x32 Flow</div><strong id="jbc_dbg_flow_${m.addr}">-</strong></div><div><div class="k">0x33 Speed</div><strong id="jbc_dbg_speed_${m.addr}">-</strong></div><div><div class="k">0x3A WORK Delay</div><strong id="jbc_dbg_workdelay_${m.addr}">-</strong></div><div><div class="k">0x3A STAND Delay</div><strong id="jbc_dbg_standdelay_${m.addr}">-</strong></div><div><div class="k">0x36 StandIntakes</div><strong id="jbc_dbg_standintakes_${m.addr}">-</strong></div><div><div class="k">0x57 ContinuousSuction</div><strong id="jbc_dbg_cont_${m.addr}">-</strong></div><div><div class="k">0x41 FilterStatus</div><strong id="jbc_dbg_filterlife_${m.addr}">-</strong></div><div><div class="k">0x45 FilterSaturation</div><strong id="jbc_dbg_filtersat_${m.addr}">-</strong></div><div><div class="k">0x59 StatError</div><strong id="jbc_dbg_error_${m.addr}">-</strong></div></div><div class="mini">TX = OFE MCU â†’ FAE Â· RX = im FAE gespeicherter / an JBC gelieferter Wert</div></details>${moduleMeta(m)}</div>`}if(m.type==9){det+=`<div class="tile module-card jbc-card jbc-usb-card"><div class="module-head"><div class="module-title">${mn(m)}</div><div class="module-head-main"><div class="module-identity"><span class="module-icon">${jbcUsbPortGlyph()}</span><div class="module-head-copy"><div class="module-type">JBC USB Host</div><div class="module-address">${hx(m.addr)}</div></div></div><div class="module-statuses"><span id="jbu_mod_${m.addr}" class="pill">-</span><span id="jbu_conn_${m.addr}" class="pill">-</span></div></div></div><div class="jbu-hero"><div class="jbu-hero-top"><div id="jbu_model_${m.addr}" class="jbu-station-name">-</div><div class="jbu-badges"><span id="jbu_proto_${m.addr}" class="jbu-chip proto">-</span><span id="jbu_kind_${m.addr}" class="jbu-chip kind">-</span><span id="jbu_portsbadge_${m.addr}" class="jbu-chip">-</span></div></div></div><div class="jbu-state-grid"><div id="jbu_workbox_${m.addr}" class="jbu-state-card"><div class="jbu-state-symbol"><span class="jbu-work-symbol" aria-label="work">${jbcUsbWorkGlyph()}</span><span id="jbu_workcount_${m.addr}" class="jbu-state-count" hidden></span></div><div class="jbu-state-copy"><small>WORK</small><strong id="jbu_work_${m.addr}">-</strong></div></div><div id="jbu_standbox_${m.addr}" class="jbu-state-card is-stand"><div class="jbu-state-symbol"><span class="jbu-stand-symbol">${jbcUsbStandGlyph()}</span><span id="jbu_standcount_${m.addr}" class="jbu-state-count" hidden></span></div><div class="jbu-state-copy"><small>STAND</small><strong id="jbu_stand_${m.addr}">-</strong></div></div></div><div class="jbu-facts"><div class="jbu-fact is-wide"><div class="k">JBC Device ID</div><div id="jbu_devid_${m.addr}" class="v mono">-</div></div><div class="jbu-fact is-wide"><div class="k">${uiLang=='de'?'Stationsname':'Station name'}</div><div id="jbu_stationname_${m.addr}" class="v">-</div></div><div id="jbu_qstactivate_box_${m.addr}" class="jbu-fact" hidden><div class="k">${uiLang=='de'?'QST aktiviert':'QST enabled'}</div><div id="jbu_qstactivate_${m.addr}" class="v">-</div></div><div id="jbu_qststatus_box_${m.addr}" class="jbu-fact" hidden><div class="k">QST Status