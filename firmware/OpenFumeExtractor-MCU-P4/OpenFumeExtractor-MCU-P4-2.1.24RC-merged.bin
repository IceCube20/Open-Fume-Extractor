# entity.1.func=read_discrete
# entity.1.reg=0x0000
# entity.1.role=main_input
`;if(!text)text=
`# Open Fume Extractor Universal RS232 profile v1
profile=${c.profile}
station=${c.station}
baud=${c.baud}
frame=${c.frame}
protocol=${c.protocol}
checksum=${c.checksum}
line_end=${c.line_end}

# entity.1.type=number
