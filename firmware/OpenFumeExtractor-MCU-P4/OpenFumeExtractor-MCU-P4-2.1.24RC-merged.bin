start␀␀␀␀Restart␀<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='color-scheme' content='dark'><link rel='icon' type='image/png' href='/favicon.png'><link rel='apple-touch-icon' href='/logo.png'><title>␀␀␀␀</title><style>:root{--bg:#0c0d0f;--card:#181b20;--card2:#20242a;--line:#303640;--text:#f3f5f7;--muted:#9ba5b1;--blue:#4a90d9;--green:#59c77a}*{box-sizing:border-box}body{margin:0;font-family:var(--ofe-font-ui);background:var(--bg);color:var(--text)}header{padding:12px 18px;min-height:66px;background:#17191d;border-bottom:1px solid #2a2e35;display:flex;align-items:center;justify-content:space-between;gap:16px;position:sticky;top:0;z-index:5}.brand{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:700}.brand-dev{min-height:28px;padding:4px 9px;font-size:11px;margin-left:4px}.brand-logo{width:38px;height:38px;border-radius:9px;object-fit:cover;box-shadow:0 0 0 1px #303640}.brand-text{line-height:1.05}.brand span{display:block;color:#929ba6;font-size:12px;font-weight:400;margin-top:4px}.nav,.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}main{width:min(940px,100%);margin:auto;padding:24px 18px 40px}.page-head{margin-bottom:18px}.eyebrow{color:var(--green);font-size:12px;font-weight:700;text-transform:uppercase}.page-head h1{font-size:25px;margin:5px 0}.page-head p,.muted,.panel p{color:var(--muted);line-height:1.45}.grid,.stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.panel{border:1px solid var(--line);background:var(--card);border-radius:8px;padding:18px;margin-bottom:12px}.panel h2{font-size:17px;margin:0 0 5px}.stat{background:var(--card2);border:1px solid #343b45;border-radius:7px;padding:12px}.k,label{display:block;color:var(--muted);font-size:12px;margin:12px 0 6px}.v{font-size:18px;font-weight:700}input,select{width:100%;min-height:42px;background:#101216;color:var(--text);border:1px solid #414854;border-radius:7px;padding:10px 11px;font:inherit;outline:none}input:focus,select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(74,144,217,.16)}button,.btn{min-height:40px;background:#326da5;color:#fff;border:1px solid #417fb9;border-radius:7px;padding:9px 14px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:background .15s,transform .08s,opacity .15s}button:hover,.btn:hover{background:#3a7fbe}button:active,.btn:active{transform:translateY(1px)}.secondary,.btn.secondary{background:#242a31;color:#dce5ef;border-color:#3a424d}.nav .active{background:#326da5;border-color:#417fb9;color:#fff}button.danger{background:#8f3b3b;border-color:#a94646}button.danger:hover{background:#a94646}.dev-toggle{min-height:34px;font-size:12px}.nav select{width:auto}.msg{border:1px solid #665329;background:#2a2417;color:#f2c96b;border-radius:7px;padding:11px}.progress{height:10px;background:#101216;border:1px solid #343a43;border-radius:99px;overflow:hidden;margin-top:14px}.bar{height:100%;width:0;background:var(--green);transition:width .15s}.upload-stat{color:var(--muted);font-size:14px;margin-top:8px;min-height:20px}.panel input[type=file]+button{margin-top:16px}.footer{display:flex;justify-content:space-between;color:#77818d;font-size:13px;margin-top:18px;padding-top:14px;border-top:1px solid #252a31}@media(max-width:700px){header{align-items:flex-start;flex-direction:column}.nav{width:100%}.nav>*{flex:1}.grid,.stat-grid{grid-template-columns:1fr}main{padding:18px 12px}}.inline-alias{width:130px;max-width:100%;height:24px;min-height:0;padding:0;border:0;background:transparent;color:var(--text);font-weight:800;font-size:1rem}.inline-alias:focus{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:0 6px;outline:none}</style><style>:root{--ofe-font-ui:Arial,Helvetica,sans-serif}body,button,input,select,textarea,pre,code,kbd,samp,svg text{font-family:var(--ofe-font-ui)}.module-card .filter-actions button{font-family:var(--ofe-font-ui);font-size:13px;font-weight:700;line-height:1.25;min-height:40px;padding:9px 14px;width:100%;min-width:0;white-space:normal}</style><style>
input[type=file]{width:100%;min-width:0;height:44px;min-height:44px;padding:0;line-height:42px;overflow:hidden;font-size:13px}
input[type=file]::file-selector-button{height:42px;margin:0 10px 0 0;padding:0 12px;border:0;border-right:1px solid var(--line);border-radius:6px 0 0 6px;background:var(--card2);color:var(--text);font:inherit;cursor:pointer;transition:background-color .15s,color .15s}
input[type=file]:enabled::file-selector-button:hover{background:#343d48;color:#fff}input[type=file]:disabled::file-selector-button{cursor:not-allowed}
.ofe-file-actions{display:grid;grid-template-columns:minmax(0,1fr);align-items:center;gap:12px 8px;min-width:0;margin:0}.ofe-file-actions>.ofe-usb-action{justify-self:start;max-width:100%;height:44px;min-height:44px;margin:0!important;padding:9px 12px;font-size:13px}
.ofe-export-actions{display:inline-flex;align-items:center;flex-wrap:wrap;gap:12px 8px;max-width:100%;vertical-align:middle}.ofe-export-actions>button,.ofe-export-actions>.btn{min-height:40px;height:40px;margin:0!important;padding:9px 12px;line-height:20px;font-size:13px}.ofe-export-actions>.ofe-usb-action{white-space:nowrap}
.ofe-file-actions+button,.ofe-file-actions+.ofe-file-actions,.ofe-export-actions+.ofe-file-actions{margin-top:12px}
body :is(.upb-actions,.mb-builder-actions,.uni-dual-action){display:flex;flex-wrap:wrap;align-items:stretch;gap:10px;min-width:0}
body :is(.upb-actions,.mb-builder-actions,.uni-dual-action)>button{flex:1 1 165px;width:auto;min-width:0}
body :is(.upb-actions,.mb-builder-actions,.uni-dual-action)>.ofe-export-actions{display:flex;flex:2 1 300px;align-items:stretch;gap:10px;width:auto;min-width:0;max-width:100%}
body :is(.upb-actions,.mb-builder-actions,.uni-dual-action)>.ofe-export-actions>button{flex:1 1 140px;width:auto;min-width:0}
body :is(.upb-actions,.mb-builder-actions,.uni-dual-action) button{height:44px;min-height:44px;margin:0!important;padding:6px 10px;font-size:12px;line-height:16px;white-space:normal;overflow-wrap:anywhere}
.jbu-station-live>.jbu-port-detail-grid{margin-top:7px}.jbu-service-read{padding:0 12px 12px;min-width:0}.jbu-service-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:stretch}.jbu-service-actions>select{flex:1 1 180px;min-width:0}.jbu-service-actions>button{height:44px;min-height:44px;flex:0 0 auto;margin:0}
@media(max-width:600px){.ofe-file-actions>.ofe-usb-action{width:100%}.ofe-export-actions{width:100%;display:flex}.ofe-export-actions>*{flex:1 1 auto}}
</style></head><body><header><div class='brand'><img class='brand-logo' src='/logo.png' alt=''><div class='brand-text'>Open Fume Extractor<span>by IceCube20</span></div><button class='secondary dev-toggle brand-dev' id='shell_dev_btn' data-enabled='␀' onclick='toggleShellDevMode()'>␀␀␀</button><span class="transport-icons"><a class="transport-ble" href="/display-link#ble" title="Bluetooth" aria-label="Bluetooth"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 7 10 10-5 5V2l5 5L7 17"/></svg></a><a class="transport-network transport-wifi" href="/config" title="Netzwerk / Network" aria-label="Netzwerk / Network"><svg data-network-icon="wifi" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/></svg><svg data-network-icon="ethernet" hidden width="22" height="22" viewBox="0 0 24 24" fill="currentColor" data-icon="mdi:ethernet" aria-hidden="true"><path transform="rotate(180 12 12)" d="M7,15H9V18H11V15H13V18H15V15H17V18H19V9H15V6H9V9H5V18H7V15M4.38,3H19.63C20.94,3 22,4.06 22,5.38V19.63A2.37,2.37 0 0,1 19.63,22H4.38C3.06,22 2,20.94 2,19.63V5.38C2,4.06 3.06,3 4.38,3Z"/></svg></a></span></div><nav class='nav'><select id='lang_sel' data-no-dirty='1' onchange='setShellLang(this.value)'><option value='de'␀>Deutsch</option><option value='en'␀>English</option></select><a class='btn ␀␀␀␀' href='/'>Status</a><a class='btn ␀' href='/config'>␀␀␀' href='/update'>Updates</a><a class='btn ␀␀diagnostics␀' href='/diagnostics'>␀␀' href='/logic'>␀␀␀␀</a><button class='danger' onclick='restartShellMaster()'>␀␀</button></nav></header><main>␀␀<button class='secondary dev-toggle brand-dev' id='shell_dev_btn'␀␀␀</button>␀␀␀<script>window.OFE_CSRF='␀␀␀';(function(){var t=window.OFE_CSRF;var of=window.fetch;window.fetch=function(u,o){o=o||{};var m=String(o.method||'GET').toUpperCase();if(m!=='GET'&&m!=='HEAD'){var h=new Headers(o.headers||{});h.set('X-CSRF-Token',t);o.headers=h;}return of(u,o)};var xo=XMLHttpRequest.prototype.open,xs=XMLHttpRequest.prototype.send;XMLHttpRequest.prototype.open=function(m,u){this._ofe_m=String(m||'GET').toUpperCase();return xo.apply(this,arguments)};XMLHttpRequest.prototype.send=function(b){if(this._ofe_m&&this._ofe_m!=='GET'&&this._ofe_m!=='HEAD')this.setRequestHeader('X-CSRF-Token',t);return xs.apply(this,arguments)};function f(){document.querySelectorAll('form').forEach(function(x){if(!x.querySelector('input[name=csrf]')){var i=document.createElement('input');i.type='hidden';i.name='csrf';i.value=t;x.appendChild(i);}})}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',f);else f();})();</script>␀<style>
.brand{flex-wrap:wrap;min-width:0}.brand .transport-icons{display:inline-flex;align-items:center;gap:4px;margin:0}
.transport-icons a{display:inline-flex;align-items:center;justify-content:center;width:32px;height:36px;color:#7b8794;text-decoration:none}
.transport-icons .transport-ble.is-on{color:#69b4ff}.transport-icons .transport-network.is-on{color:#59c77a}
.transport-icons .transport-network.is-ap{color:#f4c25b}.transport-icons svg[hidden]{display:none}.transport-icons a:hover{color:#fff}
.transport-icons .transport-usb[hidden]{display:none}.transport-icons .transport-usb{color:#f4c25b}.transport-icons .transport-usb.is-on{color:#59c77a}
</style><script>(()=>{
let last=null;
function usbHeader(s){
  let e=document.querySelector('.transport-usb');
  if(typeof s.usb_detected!=='boolean'){if(e)e.hidden=true;return}
  if(!e){e=document.createElement('a');e.className='transport-usb';e.href='/usb';e.innerHTML='<svg xmlns="http://www.w3.org/2000/svg" data-icon="mdi:usb-flash-drive" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 15C8.55 15 9 15.45 9 16C9 16.55 8.55 17 8 17C7.45 17 7 16.55 7 16C7 15.45 7.45 15 8 15M15.07 4.69L16.5 6.1L15.07 7.5L13.66 6.1L15.07 4.69M17.9 7.5L19.31 8.93L17.9 10.34L16.5 8.93L17.9 7.5M8 13C6.34 13 5 14.34 5 16C5 17.66 6.34 19 8 19C9.66 19 11 17.66 11 16C11 14.34 9.66 13 8 13M9.77 4.33L10.5 5.08L14.29 1.29C14.47 1.11 14.72 1 15 1C15.28 1 15.53 1.11 15.71 1.29L22.78 8.36L22.78 8.37C22.92 8.54 23 8.76 23 9C23 9.3 22.87 9.57 22.66 9.76L22.66 9.76L18.93 13.5L19.67 14.23L12.95 20.95C11.68 22.22 9.93 23 8 23C4.13 23 1 19.87 1 16C1 14.07 1.78 12.32 3.05 11.05L9.77 4.33M20.59 9L15 3.41L11.93 6.5L17.5 12.08L20.59 9Z"/></svg>';document.querySelector('.transport-icons')?.appendChild(e)}
  e.hidden=!s.usb_detected;e.classList.toggle('is-on',!!s.usb_mounted);e.title=german()?(s.usb_mounted?'USB-Stick bereit':'USB-Stick erkannt, nicht eingebunden'):(s.usb_mounted?'USB stick ready':'USB stick detected, not mounted');e.setAttribute('aria-label',e.title);
}
function german(){const e=document.getElementById('lang_sel');return !e||e.value!=='en'}
window.ofeSetNetworkHeader=function(s){
  last=s;const de=german(),kind=s.network_transport||(s.wifi_connected?'wifi':'offline');
  const connected=kind==='ethernet'||kind==='wifi',ip=s.network_ip||s.master_ip||'';
  const names=de?{ethernet:'Ethernet verbunden',wifi:'WLAN verbunden',ap:'WLAN-Einrichtung',offline:'Netzwerk getrennt',unknown:'Netzwerkstatus nicht verf\u00fcgbar'}:{ethernet:'Ethernet connected',wifi:'WiFi connected',ap:'WiFi setup',offline:'Network disconnected',unknown:'Network status unavailable'};
  let label=names[kind]||names.unknown;
  if(connected&&ip&&ip!=='0.0.0.0')label+=': '+ip;
  if(kind==='ethernet'&&s.wifi_enabled===false)label+=de?' - WLAN aus':' - WiFi off';
  document.querySelectorAll('.transport-network').forEach(e=>{
    e.dataset.transport=kind;e.classList.toggle('is-on',connected);e.classList.toggle('is-ap',kind==='ap');
    e.title=label;e.setAttribute('aria-label',label);
    e.querySelectorAll('[data-network-icon]').forEach(svg=>svg.toggleAttribute('hidden',svg.dataset.networkIcon!==(kind==='ethernet'?'ethernet':'wifi')));
  });
};
async function update(){
  if(document.hidden)return;
  try{const r=await fetch('/display-link/ble?brief=1',{cache:'no-store'});if(!r.ok)throw Error(r.status);const s=await r.json();
    document.querySelectorAll('.transport-ble').forEach(e=>e.classList.toggle('is-on',!!s.active));window.ofeSetNetworkHeader(s);usbHeader(s);
  }catch(e){window.ofeSetNetworkHeader({network_transport:'unknown'});usbHeader({});document.querySelectorAll('.transport-ble').forEach(e=>e.classList.remove('is-on'));}
}
const selector=document.getElementById('lang_sel');if(selector)selector.addEventListener('change',()=>{if(last)window.ofeSetNetworkHeader(last)});
document.addEventListener('visibilitychange',update);update();setInterval(update,5000);
