function universalUpdateEntity(m,d,st){let readable=universalReadable(d);if(!readable){set('uni_ent_val_'+m.addr+'_'+d.id,'â€”');if(d.type=='switch'&&universalAccessMode(d)==='wo'){let k=m.addr+':'+d.id;if(st&&typeof st.value_bool!=='undefined')universalWoSwitchVisual(m.addr,d.id,!!st.value_bool);else if(Object.prototype.hasOwnProperty.call(universalWoSwitchTarget,k))universalWoSwitchVisual(m.addr,d.id,!!universalWoSwitchTarget[k]);}return}let raw=universalRawValue(d,st),txt=universalEntityValue(d,st);set('uni_ent_val_'+m.addr+'_'+d.id,txt);if(d.type=='number'){let nm=universalNumberMeta(d),shown=raw!==''?raw:String(nm.min);let r=document.getElementById('uni_ent_in_'+m.addr+'_'+d.id);if(!fieldBusy(r))val(r,shown);if(raw==='')set('uni_ent_val_'+m.addr+'_'+d.id,'-')}else if(d.type=='switch'){let b=document.getElementById('uni_ent_sw_'+m.addr+'_'+d.id),on=!!(st&&st.value_bool);if(b){b.textContent=on?t('on'):t('off');b.className='switch uni-switch '+(on?'on':'off');b.dataset.next=on?'0':'1'}}else if(d.type=='select'){let sel=document.getElementById('uni_ent_sel_'+m.addr+'_'+d.id);if(sel&&raw!==''&&!fieldBusy(sel))val(sel,raw)}}
