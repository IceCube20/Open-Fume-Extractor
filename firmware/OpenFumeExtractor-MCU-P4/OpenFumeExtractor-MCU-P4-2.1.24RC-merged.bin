␀␀␀failed to select restored logic slot␀␀␀␀failed to restore legacy logic slot␀Backup importiert␀␀␀Backup imported␀Die Einstellungen wurden wiederhergestellt. Die MCU startet neu und Ã¼bernimmt WLAN, MQTT und MCU-Einstellungen.␀␀␀␀Settings were restored. The MCU restarts and applies WiFi, MQTT and MCU settings.␀␀␀backup_import␀␀␀backup_import_begin␀backup_json␀missing backup JSON␀backup JSON too large␀␀␀LittleFS unavailable; backup restore cannot be rolled back␀␀/restore.undo␀␀␀/restore.undo.tmp␀␀␀failed to secure previous settings before restore␀␀␀settings applied but restore commit failed; rollback pending at next boot␀␀␀; previous settings restored␀␀␀␀; previous settings restored, but undo journal could not be cleared␀; rollback pending at next boot: ␀␀␀backup import failed␀␀␀␀backup_import_applied␀␀␀</p><div class='progress'><div class='bar' style='width:100%'></div></div><p class='muted'>␀</p></section><script>setTimeout(function(){location.href='/';},12000);setTimeout(function(){location.reload();},18000);</script>␀␀␀setup mode: only network configuration is available␀/update/master␀␀/update/module␀␀/display-link␀␀␀/restart␀␀␀␀Displays suchen␀Find displays␀␀␀Abbrechen␀␀␀Cancel␀␀Code stimmt␀Code matches␀␀␀␀Ablehnen␀␀␀␀Reject␀␀const BLE_DE=true;␀␀const BLE_DE=false;␀Display koppeln␀Pair display␀␀␀␀Display-Seriennummer␀␀␀␀Display serial number␀␀␀Kopplungscode anzeigen␀␀Show pairing code␀␀␀Kopplungscode␀␀␀Pairing code␀␀␀␀UngÃ¼ltige Seriennummer oder Kopplungsspeicher nicht verfÃ¼gbar.␀␀␀␀Invalid serial number or pairing storage unavailable.␀␀␀Serial number␀␀␀Connection␀␀RS485␀␀␀serial␀␀<section class='panel' id='ble'><h2>Bluetooth</h2><div class='actions'><button type='button' onclick="bleAction('start')">␀␀</button><button type='button' class='secondary' onclick="bleAction('cancel')">␀</button></div><p id='ble_state' role='status'></p><p id='ble_search_timer' role='timer' style='font-variant-numeric:tabular-nums' hidden></p><div id='ble_devices'></div><div id='ble_confirm' hidden><strong id='ble_pin' style='font-size:28px'></strong><div class='actions' style='margin-top:12px'><button type='button' onclick="bleConfirm(true)">␀␀</button><button type='button' class='danger' onclick="bleConfirm(false)">␀␀</button></div></div></section><script>␀
let bleCurrent=null;
const bleMessages=BLE_DE?['Bereit','Bluetooth startet','Displays werden gesucht','Display auswÃ¤hlen','Kopplungsbereit','Verbindung wird aufgebaut','Zahlencode an beiden GerÃ¤ten vergleichen','BestÃ¤tigung am Display abwarten','WLAN und Kopplung werden gespeichert','Display gekoppelt','Kopplung fehlgeschlagen','Abgebrochen','Kopplungszeit abgelaufen','Nicht genÃ¼gend freier RAM']:['Ready','Starting Bluetooth','Searching for displays','Select a display','Ready to pair','Connecting','Compare the code on both devices','Waiting for display confirmation','Saving WiFi and pairing','Display paired','Pairing failed','Cancelled','Pairing timed out','Insufficient free RAM'];
async function bleAction(action,extra={}){
  try{
    const r=await fetch('/display-link/ble',{method:'POST',body:new URLSearchParams({action,...extra}),cache:'no-store'});
    if(!r.ok)throw Error(BLE_DE?'Aktion nicht mÃ¶glich. WLAN, Update und Kopplungszustand prÃ¼fen.':'Action unavailable. Check WiFi, updates and pairing state.');
    await bleRefresh();
  }catch(e){document.getElementById('ble_state').textContent=e.message}
}
function bleConfirm(accept){
  if(bleCurrent&&bleCurrent.phase===6)bleAction('confirm',{token:String(bleCurrent.token),pin:String(bleCurrent.pin),accept:accept?'1':'0'});
}
async function bleRefresh(){
  if(document.hidden)return;
  try{
    const r=await fetch('/display-link/ble',{cache:'no-store'});if(!r.ok)return;
    const d=await r.json();bleCurrent=d;
    let message=bleMessages[d.phase]||'';
    if(d.phase===10&&d.error_phase){
      const step=bleMessages[d.error_phase]||String(d.error_phase);
      message+=' ('+step+'; BLE '+String(d.error_code||0)+')';
    }
    if(d.phase===13&&Number.isFinite(d.free_internal)&&Number.isFinite(d.largest_internal)){
      const step=BLE_DE?['','Task-Start','vor Bluetooth-Start','nach Bluetooth-Start','nach Bluetooth-Stopp']:['','task startup','before Bluetooth startup','after Bluetooth startup','after Bluetooth shutdown'];
      message+=' ('+(step[d.memory_stage]||'')+': '+Math.floor(d.free_internal/1024)+' KiB '+(BLE_DE?'frei, grÃ¶ÃŸter Block ':'free, largest block ')+Math.floor(d.largest_internal/1024)+' KiB)';
    }
    document.getElementById('ble_state').textContent=message;
    const timer=document.getElementById('ble_search_timer');timer.hidden=!d.searching;
    const clock=ms=>{const s=Math.max(0,Math.floor((Number(ms)||0)/1000));return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')};
    timer.textContent=(BLE_DE?'Suche lÃ¤uft: ':'Search running: ')+clock(d.search_elapsed_ms)+' / '+clock(d.search_timeout_ms);
    const box=document.getElementById('ble_devices');box.replaceChildren();
    (d.devices||[]).forEach((item,index)=>{
      const row=document.createElement('div');row.className='actions';row.style.marginTop='12px';
      const text=document.createElement('span');text.textContent=['Display 320x480','Display 800x480','Display ST7796 320x480','Display P4 800x480'][item.kind]+' Â· '+item.serial+' Â· '+item.rssi+' dBm';
      const button=document.createElement('button');button.type='button';button.textContent=item.paired?(BLE_DE?'Gekoppelt':'Paired'):(BLE_DE?'Koppeln':'Pair');
      const selectable=d.active?(d.phase===2||d.phase===3):(d.phase===9||d.phase===10);
      button.disabled=!selectable||!!item.paired;button.onclick=()=>bleAction('select',{index:String(index),token:String(d.token)});
      row.append(text,button);box.append(row);
    });
    document.getElementById('ble_confirm').hidden=d.phase!==6;
    document.getElementById('ble_pin').textContent=String(d.pin||0).padStart(6,'0');
  }catch(e){}
}
bleRefresh();setInterval(bleRefresh,1000);
