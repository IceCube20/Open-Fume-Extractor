/* Fan/IO input states: compact label + colored Ein/Aus chip. */
.fan-card .fanio-card-tools .universal-entity.fanio-input-row{margin:0;padding:9px 0;border:0;border-bottom:1px solid #242b34;border-radius:0;background:transparent;box-shadow:none}
.fan-card .fanio-card-tools .universal-entity.fanio-input-row:last-child{border-bottom:0}
.fan-card .fanio-input-state{display:inline-flex;align-items:center;justify-content:center;min-width:52px;min-height:26px;padding:3px 10px;border:1px solid #35404b;border-radius:999px;background:#1a2027;color:#aeb8c2;font-size:11px!important;font-weight:800!important;letter-spacing:0;line-height:1;white-space:nowrap;justify-self:end}
.fan-card .fanio-input-state.is-active{border-color:#347c50;background:#173323;color:#c9f7d8}
.fan-card .fanio-input-state.is-inactive{border-color:#35404b;background:#1a2027;color:#aeb8c2}
.fan-card .fanio-input-state.is-na{opacity:.62}
.fan-card .control-row.input-row .control-copy small{display:none}
