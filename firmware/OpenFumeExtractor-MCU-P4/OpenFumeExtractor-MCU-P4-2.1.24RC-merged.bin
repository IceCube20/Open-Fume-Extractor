  return ({0:'OFF',1:'10 ms Â· 100 Hz',2:'20 ms Â· 50 Hz',3:'50 ms Â· 20 Hz',4:'100 ms Â· 10 Hz',5:'200 ms Â· 5 Hz',6:'500 ms Â· 2 Hz',7:'1000 ms Â· 1 Hz'})[Number(v)]||('Speed '+Number(v));
