ection.␀␀Zielmodul␀␀␀Target module␀␀␀Kein updatefÃ¤higes Modul online␀␀␀␀No update-capable module online␀Modul-Firmware (.bin)␀␀␀Module firmware (.bin)␀␀Entwicklermodus: Modultyp-PrÃ¼fung Ã¼berspringen␀␀␀␀Developer mode: skip module type check␀␀Modul aktualisieren␀Update Module␀␀␀Installierte Version␀␀␀␀Installed version␀␀␀Passend zur MCU-SDK␀Compatible with MCU SDK␀Freigaben prÃ¼fen␀␀␀Check approved releases␀Firmware laden und prÃ¼fen␀␀Load and verify firmware␀␀␀␀Verwerfen␀␀␀Discard␀Firmwaredatei (.bin)␀␀␀␀Firmware file (.bin)␀␀␀␀C6-UART-Wiederherstellung ist verfÃ¼gbar␀␀␀␀C6 UART recovery is available␀␀␀Nur Ã¼ber LAN. WLAN/Bluetooth werden unterbrochen; danach startet die MCU neu.␀␀Ethernet only. WiFi/Bluetooth will be interrupted; the MCU restarts afterwards.␀C6 aktualisieren␀␀␀␀Update C6␀␀␀Wiederherstellung␀␀␀Recovery␀␀␀␀<p class='msg'>␀<div class='grid'><section class='panel'><h2>MCU OTA</h2><p>␀␀␀␀</p><form id='masterForm' method='post' action='/update/master' enctype='multipart/form-data'><label>␀␀␀</label><input id='master_fw_file' type='file' name='firmware' accept='.bin'><div id='master_fw_info' class='muted' style='margin-top:8px'></div><label class='dev-fw-override' style='display:none;margin-top:10px;padding:10px;border:1px solid #5b4a22;border-radius:8px;background:#211b10;color:#f4c25b'><input type='checkbox' name='unsafe' value='1' style='width:auto;min-height:0;margin-right:8px'><span>␀␀␀␀</span></label><button id='master_update_btn' type='submit'>␀␀␀␀</button><div class='progress'><div id='masterBar' class='bar'></div></div><div id='masterStat' class='upload-stat'></div></form></section>␀<section class='panel'><h2>Module OTA</h2><p>␀␀␀</p><form id='moduleForm' method='post' action='/update/module' enctype='multipart/form-data'><label>␀␀␀</label><select name='addr'>␀␀␀␀' data-type='␀␀␀' data-caps='␀␀␀' data-transport='␀␀' data-name='␀␀␀'>0x␀␀␀␀ - FW ␀␀ - ␀</label><input id='module_fw_file' type='file' name='firmware' accept='.bin'><div id='module_fw_info' class='muted' style='margin-top:8px'></div><label class='dev-fw-override' style='display:none;margin-top:10px;padding:10px;border:1px solid #5b4a22;border-radius:8px;background:#211b10;color:#f4c25b'><input type='checkbox' name='unsafe' value='1' style='width:auto;min-height:0;margin-right:8px'><span>␀␀␀␀</span></label><button id='module_update_btn' type='submit' style='margin-top:16px'>␀␀␀␀</button><div class='progress'><div id='moduleBar' class='bar'></div></div><div id='moduleStat' class='upload-stat'></div></form></section></div>␀␀␀<section class='panel' id='c6_panel'><h2>ESP32-C6 Â· WLAN / Bluetooth</h2><div class='grid'><div><label>␀␀␀␀</label><strong id='c6_current'>-</strong></div><div><label>␀␀␀␀</label><strong>␀␀␀␀</strong></div></div><div class='actions' style='margin-top:12px'><button type='button' class='secondary' id='c6_catalog_check'>␀␀␀␀</button></div><p class='muted' id='c6_catalog_state' role='status'></p><p id='c6_state' role='status'>-</p><div class='actions'><button type='button' id='c6_download'>␀␀␀␀</button><button type='button' class='secondary' id='c6_cancel' disabled>␀␀␀</button></div><label for='c6_file'>␀␀␀␀</label><input id='c6_file' type='file' accept='.bin'><label style='display:flex;gap:8px;align-items:center;margin-top:12px'><input id='c6_recovery' type='checkbox' style='width:auto;min-height:0'>␀␀␀</label><p class='muted'>␀␀␀</p><div class='actions'><button type='button' id='c6_install' disabled>␀␀␀␀</button><a class='btn secondary' href='https://docs.waveshare.com/ESP32-P4-Module-DEV-KIT/FAQ' target='_blank' rel='noopener noreferrer'>␀␀</a></div><div class='progress'><div id='c6_bar' class='bar'></div></div></section><script>window.OFE_C6={de:␀␀␀,size:␀␀,url:'␀␀',expected:␀,board:'␀␀␀␀',arduino:'␀',idf:'␀',sha256:'␀␀',catalog:'␀',csrf:'␀␀␀␀'};</script>␀␀␀␀<script>(()=>{
'use strict';
function version(text){if(typeof text!=='string'||!/^\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(text))throw Error('CATALOG_INVALID');const p=text.split('.').map(Number);if(p.some(n=>n>255))throw Error('CATALOG_INVALID');return p[0]*65536+p[1]*256+p[2];}
function inspect(data,cfg,host){
 if(!data||data.schema!==1||!Array.isArray(data.releases)||data.releases.length>32)throw Error('CATALOG_INVALID');
 const ids=new Set(),matches=[];let newest=0;
 for(const r of data.releases){
  const h=r&&r.host,c=r&&r.coprocessor;
  if(!r||typeof r.id!=='string'||r.id.length<1||r.id.length>96||ids.has(r.id)||!['approved','withdrawn'].includes(r.status)||typeof r.board!=='string'||r.transport!=='sdio'||!h||!c||c.chip!=='esp32c6'||!Number.isInteger(c.size)||c.size<1||c.size>2097152||typeof c.sha256!=='string'||!/^[a-f0-9]{64}$/.test(c.sha256)||typeof c.url!=='string'||c.url!==`https://espressif.github.io/arduino-esp32/hosted/esp32c6-v${c.version}.bin`)throw Error('CATALOG_INVALID');
  ids.add(r.id);version(h.arduino_esp32);version(h.esp_idf);const v=version(c.version);if(v!==version(h.esp_hosted))throw Error('CATALOG_INVALID');
  if(r.board!==cfg.board||r.status!=='approved')continue;
  newest=Math.max(newest,v);
  if(h.arduino_esp32===cfg.arduino&&h.esp_idf===cfg.idf&&v===host)matches.push(r);
 }
 if(matches.length>1)throw Error('CATALOG_INVALID');
 const r=matches[0],c=r&&r.coprocessor;
 const pinned=!!c&&version(c.version)===cfg.expected&&c.url===cfg.url&&c.size===cfg.size&&c.sha256===cfg.sha256;
 return {kind:pinned?'approved':r?'master_update':'none',version:pinned?cfg.expected:newest,newerSdk:newest>host};
}
async function load(url){
 const response=await fetch(url,{cache:'no-store',credentials:'omit',referrerPolicy:'no-referrer',signal:AbortSignal.timeout(8000)});
 if(!response.ok)throw Error('HTTP '+response.status);
 const reader=response.body.getReader(),decoder=new TextDecoder();let size=0,text='';
 try{for(;;){const part=await reader.read();if(part.done)break;size+=part.value.byteLength;if(size>32768)throw Error('CATALOG_INVALID');text+=decoder.decode(part.value,{stream:true});}text+=decoder.decode();return JSON.parse(text);}finally{await reader.cancel();reader.releaseLock();}
}
window.OFE_C6_CATALOG={inspect,load};
