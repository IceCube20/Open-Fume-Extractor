val('jbc_suction',d.jbc.suction_level);val('jbc_select',customPower(d.jbc.select_flow));val('jbc_delay_work',d.jbc.delay_work_sec);val('jbc_delay_stand',d.jbc.delay_stand_sec);val('jbc_stand',d.jbc.stand_intakes?1:0);val('jbc_cont',d.jbc.continuous?1:0);val('afterrun_power_enabled',d.afterrun_power_enabled?1:0);val('afterrun_power',Math.round(Number(d.afterrun_power||300)/10));let jp=document.getElementById('jbc_select'),jm=mainOutputMin(d),jx=mainOutputMax(d);if(jp){jp.min=jm;jp.max=jx;if(!fieldBusy(jp)){let v=Number(jp.value||0);if(v<jm)val(jp,jm);else if(v>jx)val(jp,jx)}}let ap=document.getElementById('afterrun_power');if(ap){ap.min=jm;ap.max=jx;if(!fieldBusy(ap)){let v=Number(ap.value||0);if(v<jm)val(ap,jm);else if(v>jx)val(ap,jx)}}
