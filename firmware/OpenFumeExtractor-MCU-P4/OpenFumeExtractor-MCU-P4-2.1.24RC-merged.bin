function cpuCoreText(values){
  if(!Array.isArray(values)||!values.length)return '-';
  return values.map((value,core)=>'Core '+core+': '+(typeof value==='number'&&Number.isFinite(value)&&value>=0&&value<=100?Math.round(value)+'%':'-')).join(' Â· ');
}
function runtimeProfileHtml(s,de){
  if(!s)return '';
  const t=(g,e)=>de?g:e;
  if(!s.active||!Number.isFinite(Number(s.window_ms))||Number(s.window_ms)<=0)return t('Warte auf Messfenster','Awaiting sample window');
  const n=v=>Number.isFinite(Number(v))?Math.max(0,Number(v)):0;
  const ms=v=>(n(v)/1000).toFixed(2)+' ms';
  const labels={loop:t('Steuerloop','Control loop'),http:'HTTP / WLAN',mqtt:'MQTT',heap:t('Heap-Diagnose','Heap diagnostics'),mqtt_send:t('MQTT-Versand','MQTT publish')};
  let html='<div>'+t('Task-CPU (100% = ein Kern)','Task CPU (100% = one core)')+' Â· '+t('Fenster','Window')+' '+n(s.window_ms)+' ms Â· '+t('Alter','Age')+' '+n(s.age_ms)+' ms</div>';
  for(const task of s.tasks||[]){
    if(!Object.hasOwn(labels,task.id))continue;
    const core=Number.isInteger(task.core)&&task.core>=0?'Core '+task.core:t('flexibel / unbekannt','floating / unknown');
    const cpu=typeof task.cpu_pct==='number'&&Number.isFinite(task.cpu_pct)&&task.cpu_pct>=0&&task.cpu_pct<=100?Math.round(task.cpu_pct)+'%':'-';
    html+='<div>'+labels[task.id]+' ('+core+'): <strong>'+cpu+'</strong></div>';
  }
  html+='<div style="margin-top:6px">'+t('Loop-Abschnitte: Laufzeit inkl. Warten/VerdrÃ¤ngung, keine CPU-Prozente','Loop phases: elapsed time includes waits/preemption, not CPU percentages')+'</div>';
  const phases={local:t('CLI / LEDs / lokaler Service','CLI / LEDs / local service'),command:t('Bedienbefehle','Commands'),ota:'OTA',scheduler:'Bus-Scheduler',logic:t('Logik','Logic'),maintenance:t('Nachbereitung','Maintenance')};
  for(const [key,label] of Object.entries(phases)){
    const p=s.phases&&s.phases[key];if(!p)continue;
    html+='<div>'+label+': '+(n(p.calls)?'Ã˜ '+ms(p.avg_us)+' Â· max '+ms(p.max_us)+' Â· '+(n(p.total_us)/n(s.window_ms)).toFixed(1)+' ms/s':'-')+'</div>';
  }
  return html;
}
</script>␀␀␀<div class='page-head'><div class='eyebrow'>␀␀␀␀</div><h1>␀␀</h1></div>␀Passwort gespeichert␀␀␀␀Netzwerk␀␀␀␀Password saved␀␀Network␀Das neue Webpasswort wurde gespeichert. Bitte melde dich mit dem neuen Passwort erneut an.␀␀The new web password was saved. Please sign in again with the new password.␀Zur Netzwerkseite␀␀␀Open network setup␀␀web_pass_confirm␀␀␀␀<section class='panel'><h2>␀</p><div class='actions'><a class='btn' href='/config'>␀</a></div></section><script>setTimeout(function(){location.href='/config';},1800);</script>␀<div class='footer'><span>Open Fume Extractor</span><span>MCU FW 2.1.24RC</span></div></main><script>function shellLang(){var e=document.getElementById('lang_sel');return e&&e.value==='en'?'en':'de'}function setShellDevMode(enabled){enabled=!!enabled;localStorage.setItem('ofe_dev_mode',enabled?'1':'0');document.body.classList.toggle('dev-mode',enabled);var b=document.getElementById('shell_dev_btn');if(b){b.dataset.enabled=enabled?'1':'0';b.textContent=(enabled?'âœ“ ':'')+(shellLang()==='de'?'Entwicklermodus':'Developer mode')}try{if(typeof DEV_MODE!=='undefined')DEV_MODE=enabled;if(typeof devMode!=='undefined')devMode=enabled;if(typeof applyUpdateDevMode==='function')applyUpdateDevMode();if(typeof applyDevMode==='function')applyDevMode();}catch(e){}}async function refreshShellDevMode(){try{var r=await fetch('/led_state',{cache:'no-store'});if(!r.ok)return;var d=await r.json();if(typeof d.developer_mode==='boolean')setShellDevMode(!!d.developer_mode);}catch(e){}}async function setShellLang(v){try{await fetch('/language/set?lang='+(v==='en'?'en':'de'),{method:'POST',cache:'no-store'});}catch(e){}location.reload();}async function toggleShellDevMode(){var lang=shellLang();var btn=document.getElementById('shell_dev_btn');var active=btn&&btn.dataset.enabled==='1';var body=new URLSearchParams();body.set('enabled',active?'0':'1');if(!active){var pw=prompt(lang==='de'?'Entwicklerpasswort':'Developer password');if(pw===null)return;body.se