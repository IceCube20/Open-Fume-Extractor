}
function jbcTextField(label,value){
  return '<span class="jbc-value text"><span class="jbc-chip-label">'+esc(label)+'</span><span class="jbc-chip-value">'+esc(value)+'</span></span>';
}
function jbcUsbToolNameDiag(id){
