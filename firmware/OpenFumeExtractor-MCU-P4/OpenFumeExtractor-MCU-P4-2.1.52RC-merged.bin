function fanIoLegacyPwmUnitSet(addr,unit){let input=document.getElementById('fi_pfreq_'+addr);if(!input)return;let old=input.dataset.unit=='khz'?'khz':'hz',v=Number(input.value);if(!Number.isFinite(v))v=old=='khz'?1:1000;let hz=old=='khz'?v*1000:v,nu=unit=='khz'?'khz':'hz';input.dataset.unit=nu;input.min=nu=='khz'?'0.01':'10';input.max=nu=='khz'?'30':'30000';input.step=nu=='khz'?'0.001':'1';input.value=nu=='khz'?String(Number((hz/1000).toFixed(3))):String(Math.round(hz))}
