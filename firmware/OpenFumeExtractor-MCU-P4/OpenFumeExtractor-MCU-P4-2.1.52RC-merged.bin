const baseline=cfg.baseline||stable,hostExpected=cfg.hostExpected||stable.expected;
const targetSelect=$('target'),upstreamTargets=new Map();
const upstreamMode=()=>!!targetSelect&&targetSelect.value.startsWith('upstream:');
