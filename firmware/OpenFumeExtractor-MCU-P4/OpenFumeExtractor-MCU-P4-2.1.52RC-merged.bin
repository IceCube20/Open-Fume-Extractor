 $('recovery_text').textContent=mode==='stable'?say('C6-UART-Wiederherstellung ist verfÃ¼gbar','C6 UART recovery is available'):say('Ich akzeptiere den experimentellen Test und den moeglicherweise erforderlichen C6-UART-Rueckweg.','I accept the experimental trial and potentially required direct C6 UART recovery.');
