  const common={0x00:'M_HS',0x15:'M_NACK',0x21:'Firmware',0x30:'InfoPort',0x80:'ReadContiMode',0x81:'WriteContiMode',0x82:'ContiInfo',0xE0:'ReadConnectStatus',0xE1:'WriteConnectStatus'};
