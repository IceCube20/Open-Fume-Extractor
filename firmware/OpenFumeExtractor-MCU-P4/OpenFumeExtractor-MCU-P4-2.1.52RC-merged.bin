function universalFrame(e){
  let b=hexBytes(e.data||''),dir=String(e.dir||''),status=Number(e.status);
  let tx=dir==='UART_TX';
  let kind=tx?(Number(e.cmd)===0x4C?'line':'raw'):'rx';
