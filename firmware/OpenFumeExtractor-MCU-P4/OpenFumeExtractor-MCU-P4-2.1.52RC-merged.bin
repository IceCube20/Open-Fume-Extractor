`;if(!text)text=
`# Open Fume Extractor Universal RS232 profile v1
profile=${c.profile}
station=${c.station}
baud=${c.baud}
frame=${c.frame}
protocol=${c.protocol}
checksum=${c.checksum}
line_end=${c.line_end}

# entity.1.type=number
