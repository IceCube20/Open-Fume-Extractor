.fanio-led-zone{border-top:1px solid var(--line);margin-top:16px;padding-top:16px}
.fanio-led-zone input[type=color]{height:42px;min-width:0;padding:4px;background:var(--card);border:1px solid var(--line)}
.fanio-led-zone .fanio-field-grid>button:last-child{width:44px;min-width:44px;justify-self:end;align-self:end}
.fanio-led-zone+.fanio-led-zone{margin-top:20px}
html[data-ofe-theme=light] .fanio-editor-panel h3{color:var(--text)}
</style><script>
(()=>{const key='ofe-web-theme',root=document.documentElement,system=matchMedia('(prefers-color-scheme: dark)');let mode='auto';try{const stored=localStorage.getItem(key);if(['auto','light','dark'].includes(stored))mode=stored}catch(_){}
const apply=()=>{root.dataset.ofeTheme=mode==='auto'?(system.matches?'dark':'light'):mode};apply();system.addEventListener('change',apply);
addEventListener('DOMContentLoaded',()=>{const nav=document.querySelector('body>header .nav');if(!nav)return;const control=document.createElement('select');control.id='ofe_theme';for(const value of ['auto','light','dark'])control.add(new Option(value,value));control.value=mode;const labels=()=>{const de=document.getElementById('lang_sel')?.value==='de';control.title=de?'Darstellung':'Appearance';control.setAttribute('aria-label',control.title);[...control.options].forEach(o=>o.textContent=o.value==='auto'?'Auto':o.value==='light'?(de?'Hell':'Light'):(de?'Dunkel':'Dark'))};control.onchange=()=>{mode=control.value;try{localStorage.setItem(key,mode)}catch(_){}apply()};nav.prepend(control);labels();document.addEventListener('change',e=>{if(e.target.id==='lang_sel')labels()})});
})();
</script></head><body><header><div class='brand'><img class='brand-logo' src='/logo.png' alt=''><div class='brand-text'>Open Fume Extractor<span>by IceCube20</span></div><button class='secondary dev-toggle brand-dev' id='shell_dev_btn' data-enabled='␀␀␀' onclick='toggleShellDevMode()'>␀␀␀</button><span class="transport-icons"><a class="transport-ble" href="/display-link#ble" title="Bluetooth" aria-label="Bluetooth"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 7 10 10-5 5V2l5 5L7 17"/></svg></a><a class="transport-network transport-wifi" href="/config" title="Netzwerk / Network" aria-label="Netzwerk / Network"><svg data-network-icon="wifi" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/></svg><svg data-network-icon="ethernet" hidden width="22" height="22" viewBox="0 0 24 24" fill="currentColor" data-icon="mdi:ethernet" aria-hidden="true"><path transform="rotate(180 12 12)" d="M7,15H9V18H11V15H13V18H15V15H17V18H19V9H15V6H9V9H5V18H7V15M4.38,3H19.63C20.94,3 22,4.06 22,5.38V19.63A2.37,2.37 0 0,1 19.63,22H4.38C3.06,22 2,20.94 2,19.63V5.38C2,4.06 3.06,3 4.38,3Z"/></svg></a></span></div><nav class='nav'><select id='lang_sel' data-no-dirty='1' onchange='setShellLang(this.value)'><option value='de'␀>Deutsch</option><option value='en'␀>English</option></select><a class='btn ␀␀␀␀' href='/'>Status</a><a class='btn ␀' href='/config'>␀␀␀' href='/update'>Updates</a><a class='btn ␀␀diagnostics␀' href='/diagnostics'>␀␀' href='/logic'>␀␀␀␀</a><button class='danger' onclick='restartShellMaster()'>␀␀</button></nav></header><main>␀␀<button class='secondary dev-toggle brand-dev' id='shell_dev_btn'␀␀␀</button>␀␀␀<script>window.OFE_CSRF='␀␀␀';(function(){var t=window.OFE_CSRF;var of=window.fetch;window.fetch=function(u,o){o=o||{};var m=String(o.method||'GET').toUpperCase();if(m!=='GET'&&m!=='HEAD'){var h=new Headers(o.headers||{});h.set('X-CSRF-Token',t);o.headers=h;}return of(u,o)};var xo=XMLHttpRequest.prototype.open,xs=XMLHttpRequest.prototype.send;XMLHttpRequest.prototype.open=function(m,u){this._ofe_m=String(m||'GET').toUpperCase();return xo.apply(this,arguments)};XMLHttpRequest.prototype.send=function(b){if(this._ofe_m&&this._ofe_m!=='GET'&&this._ofe_m!=='HEAD')this.setRequestHeader('X-CSRF-Token',t);return xs.apply(this,arguments)};function f(){document.querySelectorAll('form').forEach(function(x){if(!x.querySelector('input[name=csrf]')){var i=document.createElement('input');i.type='hidden';i.name='csrf';i.value=t;x.appendChild(i);}})}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',f);else f();})();</script>␀<style>
.brand{flex-wrap:wrap;min-width:0}.brand .transport-icons{display:inline-flex;align-items:center;gap:4px;margin:0}
.transport-icons a{display:inline-flex;align-items:center;justify-content:center;width:32px;height:36px;color:#7b8794;text-decoration:none}
.transport-icons .transport-ble.is-on{color:#69b4ff}.transport-icons .transport-network.is-on{color:#59c77a}
.transport-icons .transport-network.is-ap{color:#f4c25b}.transport-icons svg[hidden]{display:none}.transport-icons a:hover{color:#fff}
.transport-icons .transport-usb[hidden]{display:none}.transport-icons .transport-usb{color:#f4c25b}.transport-icons .transport-usb.is-on{color:#59c77a}
</style><script>(()=>{
let last=null;
function usbHeader(s){
  let e=document.querySelector('.transport-usb');
  if(typeof s.usb_detected!=='boolean'){if(e)e.hidden=true;return}
  if(!e){e=document.createElement('a');e.className='transport-usb';e.href='/usb';e.innerHTML='<svg xmlns="http://www.w3.org/2000/svg" data-icon="mdi:usb-flash-drive" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 15C8.55 15 9 15.45 9 16C9 16.55 8.55 17 8 17C7.45 17 7 16.55 7 16C7 15.45 7.45 15 8 15M15.07 4.69L16.5 6.1L15.07 7.5L13.66 6.1L15.07 4.69M17.9 7.5L19.31 8.93L17.9 10.34L16.5 8.93L17.9 7.5M8 13C6.34 13 5 14.34 5 16C5 17.66 6.34 19 8 19C9.66 19 11 17.66 11 16C11 14.34 9.66 13 8 13M9.77 4.33L10.5 5.08L14.29 1.29C14.47 1.11 14.72 1 15 1C15.28 1 15.53 1.11 15.71 1.29L22.78 8.36L22.78 8.37C22.92 8.54 23 8.76 23 9C23 9.3 22.87 9.57 22.66 9.76L22.66 9.76L18.93 13.5L19.67 14.23L12.95 20.95C11.68 22.22 9.93 23 8 23C4.13 23 1 19.87 1 16C1 14.07 1.78 12.32 3.05 11.05L9.77 4.33M20.59 9L15 3.41L11.93 6.5L17.5 12.08L20.59 9Z"/></svg>';document.querySelector('.transport-icons')?.appendChild(e)}
  e.hidden=!s.usb_detected;e.classList.toggle('is-on',!!s.usb_mounted);e.title=german()?(s.usb_mounted?'USB-Stick bereit':'USB-Stick erkannt, nicht eingebunden'):(s.usb_mounted?'USB stick ready':'USB stick detected, not mounted');e.setAttribute('aria-label',e.title);
}
function german(){const e=document.getElementById('lang_sel');return !e||e.value!=='en'}
window.ofeSetNetworkHeader=function(s){
  last=s;const de=german(),kind=s.network_transport||(s.wifi_connected?'wifi':'offline');
  const connected=kind==='ethernet'||kind==='wifi',ip=s.network_ip||s.master_ip||'';
  const names=de?{ethernet:'Ethernet verbunden',wifi:'WLAN verbunden',ap:'WLAN-Einrichtung',offline:'Netzwerk getrennt',unknown:'Netzwerkstatus nicht verf\u00fcgbar'}:{ethernet:'Ethernet connected',wifi:'WiFi connected',ap:'WiFi setup',offline:'Network disconnected',unknown:'Network status unavailable'};
  let label=names[kind]||names.unknown;
  if(connected&&ip&&ip!=='0.0.0.0')label+=': '+ip;
  if(kind==='ethernet'&&s.wifi_enabled===false)label+=de?' - WLAN aus':' - WiFi off';
  document.querySelectorAll('.transport-network').forEach(e=>{
    e.dataset.transport=kind;e.classList.toggle('is-on',connected);e.classList.toggle('is-ap',kind==='ap');
    e.title=label;e.setAttribute('aria-label',label);
    e.querySelectorAll('[data-network-icon]').forEach(svg=>svg.toggleAttribute('hidden',svg.dataset.networkIcon!==(kind==='ethernet'?'ethernet':'wifi')));
  });
};
async function update(){
  if(document.hidden)return;
  try{const r=await fetch('/display-link/ble?brief=1',{cache:'no-store'});if(!r.ok)throw Error(r.status);const s=await r.json();
    document.querySelectorAll('.transport-ble').forEach(e=>e.classList.toggle('is-on',!!s.active));window.ofeSetNetworkHeader(s);usbHeader(s);
  }catch(e){window.ofeSetNetworkHeader({network_transport:'unknown'});usbHeader({});document.querySelectorAll('.transport-ble').forEach(e=>e.classList.remove('is-on'));}
}
const selector=document.getElementById('lang_sel');if(selector)selector.addEventListener('change',()=>{if(last)window.ofeSetNetworkHeader(last)});
const dev=document.querySelector('header .brand-dev');if(dev){const label=()=>{dev.title=dev.textContent.trim()};label();new MutationObserver(label).observe(dev,{childList:true,subtree:true,characterData:true})}
const nav=document.querySelector('header .nav'),active=nav?.querySelector('.active');
if(nav&&active&&window.matchMedia('(max-width:700px)').matches)nav.scrollLeft=Math.max(0,active.offsetLeft-nav.offsetLeft-6);
document.addEventListener('visibilitychange',update);update();setInterval(update,5000);
})();</script>␀<script defer src='/usb/ui.js'></script>␀␀␀␀<script>
function cpuCoreText(values){
  if(!Array.isArray(values)||!values.length)return '-';
  return values.map((value,core)=>'Core '+core+': '+(typeof value==='number'&&Number.isFinite(value)&&value>=0&&value<=100?Math.round(value)+'%':'-')).join(' Â· ');
}
function runtimeProfileHtml(s,de){
  if(!s)return '';
  const t=(g,e)=>de?g:e;
  if(!s.active||!Number.isFinite(Number(s.window_ms))||Number(s.window_ms)<=0)return t('Warte auf Messfenster','Awaiting sample window');
  const n=v=>Number.isFinite(Number(v))?Math.max(0,Number(v)):0;
  const ms=v=>(n(v)/1000).toFixed(2)+' ms';
  const labels={loop:t('Steuerloop','Control loop'),http:'HTTP / WLAN',mqtt:'MQTT',heap:t('Heap-Diagnose','Heap diagnostics'),mqtt_send:t('MQTT-Versand','MQTT publish')};
  let html='<div>'+t('Task-CPU (100% = ein Kern)','Task CPU (100% = one core)')+' Â· '+t('Fenster','Window')+' '+n(s.window_ms)+' ms Â· '+t('Alter','Age')+' '+n(s.age_ms)+' ms</div>';
  for(const task of s.tasks||[]){
    if(!Object.hasOwn(labels,task.id))continue;
    const core=Number.isInteger(task.core)&&task.core>=0?'Core '+task.core:t('flexibel / unbekannt','floating / unknown');
    const cpu=typeof task.cpu_pct==='number'&&Number.isFinite(task.cpu_pct)&&task.cpu_pct>=0&&task.cpu_pct<=100?Math.round(task.cpu_pct)+'%':'-';
    html+='<div>'+labels[task.id]+' ('+core+'): <strong>'+cpu+'</strong></div>';
  }
  html+='<div style="margin-top:6px">'+t('Loop-Abschnitte: Laufzeit inkl. Warten/VerdrÃ¤ngung, keine CPU-Prozente','Loop phases: elapsed time includes waits/preemption, not CPU percentages')+'</div>';
  const phases={local:t('CLI / LEDs / lokaler Service','CLI / LEDs / local service'),command:t('Bedienbefehle','Commands'),ota:'OTA',scheduler:'Bus-Scheduler',logic:t('Logik','Logic'),maintenance:t('Nachbereitung','Maintenance')};
  for(const [key,label] of Object.entries(phases)){
    const p=s.phases&&s.phases[key];if(!p)continue;
    html+='<div>'+label+': '+(n(p.calls)?'Ã˜ '+ms(p.avg_us)+' Â· max '+ms(p.max_us)+' Â· '+(n(p.total_us)/n(s.window_ms)).toFixed(1)+' ms/s':'-')+'</div>';
  }
  return html;
}
</script>␀␀␀<div class='page-head'><div class='eyebrow'>␀␀␀␀</div><h1>␀␀</h1></div>␀Passwort gespeichert␀␀␀␀Netzwerk␀␀␀␀Password saved␀␀Network␀Das neue Webpasswort wurde gespeichert. Bitte melde dich mit dem neuen Passwort erneut an.␀␀The new web password was saved. Please sign in again with the new password.␀Zur Netzwerkseite␀␀␀Open network setup␀␀web_pass_confirm␀␀␀␀<section class='panel'><h2>␀</p><div class='actions'><a class='btn' href='/config'>␀</a></div></section><script>setTimeout(function(){location.href='/config';},1800);</script>␀<div class='footer'><span>Open Fume Extractor</span><span>MCU FW 2.1.52RC</span></div></main><script>function shellLang(){var e=document.getElementById('lang_sel');return e&&e.value==='en'?'en':'de'}function setShellDevMode(enabled){enabled=!!enabled;localStorage.setItem('ofe_dev_mode',enabled?'1':'0');document.body.classList.toggle('dev-mode',enabled);var b=document.getElementById('shell_dev_btn');if(b){b.dataset.enabled=enabled?'1':'0';b.textContent=(enabled?'âœ“ ':'')+(shellLang()==='de'?'Entwicklermodus':'Developer mode')}try{if(typeof DEV_MODE!=='undefined')DEV_MODE=enabled;if(typeof devMode!=='undefined')devMode=enabled;if(typeof applyUpdateDevMode==='function')applyUpdateDevMode();if(typeof applyDevMode==='function')applyDevMode();}catch(e){}}async function refreshShellDevMode(){try{var r=await fetch('/led_state',{cache:'no-store'});if(!r.ok)return;var d=await r.json();if(typeof d.developer_mode==='boolean')setShellDevMode(!!d.developer_mode);}catch(e){}}async function setShellLang(v){try{await fetch('/language/set?lang='+(v==='en'?'en':'de'),{method:'POST',cache:'no-store'});}catch(e){}location.reload();}async function toggleShellDevMode(){var lang=shellLang();var btn=document.getElementById('shell_dev_btn');var active=btn&&btn.dataset.enabled==='1';var body=new URLSearchParams();body.set('enabled',active?'0':'1');if(!active){var pw=prompt(lang==='de'?'Entwicklerpasswort':'Developer password');if(pw===null)return;body.set('password',pw)}try{var r=await fetch('/developer/mode',{method:'POST',body:body,cache:'no-store'});if(!r.ok)throw await r.text();var j=await r.json().catch(function(){return {enabled:!active}});setShellDevMode(!!j.enabled);}catch(e){alert((lang==='de'?'Entwicklermodus: ':'Developer mode: ')+e)}}async function restartShellMaster(){if(!confirm(shellLang()==='de'?'MCU wirklich neu starten':'Restart master'))return;await fetch('/restart',{method:'POST',cache:'no-store'});setTimeout(function(){location.reload()},3500)}refreshShellDevMode();window.addEventListener('pageshow',refreshShellDevMode);</script></body></html>␀␀text/html; charset=utf-8␀␀␀␀alias saved␀alias cleared␀␀␀missing uid or key␀␀bad uid␀main␀␀␀␀in1␀in2␀out1␀␀␀␀out2␀␀␀␀bad key␀alias␀␀␀module did not accept alias␀,"universal_entity_defs":[␀␀source␀␀,"meta":{"source":"profile"␀idx␀profile_index␀␀␀,"cpu_load_pct":␀␀␀␀,"cpu_core_load_pct":[␀␀null␀␀␀␀module_power_save_enabled_value␀module_power_save_enabled␀␀␀module_power_save_idle_min␀␀Failed to persist power-save settings␀␀␀missing rule index␀␀bad rule index␀␀sa␀␀tt␀␀tb␀␀bad rule␀␀␀␀failed to persist input rule␀␀␀␀bad main input␀␀failed to persist main input␀␀␀␀[NVS] network settings unavailable; using bootstrap defaults␀␀␀␀ssid␀␀␀␀host␀␀␀␀admin␀␀␀ap_pass␀255.255.255.0␀␀␀mqtt_en␀mqtt_tls␀␀␀␀mqtt_ha␀mqtt_host␀␀␀mqtt_port␀␀␀mqtt_user␀␀␀mqtt_pass␀␀␀mqtt_topic␀␀mqtt_disc␀␀␀led_en␀␀led_pct␀eco_en␀␀eco_idle␀␀␀␀mqtt_ca␀[AUTH] initial web user ␀␀␀␀module/%02X/status␀␀module/%02X/state␀␀␀restarting␀␀speed set failed␀␀␀␀reset_filter␀␀␀␀filter reset failed␀filter_minutes␀␀invalid filter minutes␀␀filter runtime set failed␀␀␀missing command␀Einstellungen␀␀␀Settings␀␀␀␀Netzwerk, Web-Login, MQTT und Systemeinstellungen der MCU.␀␀Network, web login, MQTT and MCU system settings.␀␀␀Webpasswort festlegen␀␀␀Set web password␀␀␀␀Das Standardpasswort ist nur fÃ¼r die Ersteinrichtung gÃ¼ltig. Bitte lege jetzt ein eigenes Passwort fest.␀␀The default password is only valid for initi