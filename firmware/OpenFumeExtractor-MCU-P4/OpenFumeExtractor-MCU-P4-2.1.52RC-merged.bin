  newerSdk=newerSdk||hostVersion>host;
  if(h.arduino_esp32===cfg.arduino&&h.esp_idf===cfg.idf&&hostVersion===host)matches.push(r);
 }
 if(matches.length>1)throw Error('CATALOG_INVALID');
