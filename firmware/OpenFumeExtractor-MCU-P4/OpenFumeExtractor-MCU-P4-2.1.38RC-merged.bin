f){f.textContent=m;f.style.display='block'}c.setCustomValidity(m);c.focus();return false}c.setCustomValidity('');return true}document.getElementById('web_pass_new').focus();</script>␀␀<section class='panel' id='master_hardware'><h2>␀␀␀␀</h2><dl style='display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:12px 20px;margin:0'>␀␀␀␀<div style='min-width:0;overflow-wrap:anywhere'><dt class='muted'>␀␀</dt><dd style='margin:4px 0 0;font-weight:600'>␀␀␀␀</dd></div>␀Waveshare Module DEV KIT␀␀␀␀Board␀␀␀ESP32P4_DEV␀RISC-V␀␀%u.%u␀␀␀ MHz␀␀␀␀%.1f MiB␀␀␀␀PSRAM (SDK)␀3.3.12␀␀Arduino-ESP32␀␀␀ESP-IDF␀ESP32-C6 (SDIO)␀%u.%u.%u␀␀␀␀</dl></section>␀<section class='panel connection-status'><div style='display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap'><h2 style='margin:0'>␀</h2><span class='muted' style='font-size:12px'>␀␀␀␀</span></div><div class='stat-grid' style='margin-top:14px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))'><div class='stat'><div class='k'>␀␀Access Point␀␀␀␀</div></div><div class='stat'><div class='k'>IP</div><div class='v'>␀␀␀␀</div></div><div class='stat'><div class='k'>SSID</div><div class='v'>␀␀</div></div><div class='stat'><div class='k'>␀␀␀Signal␀␀ dBm␀␀␀␀</div></div><div class='stat'><div class='k'>WLAN</div><div class='v'>␀␀</div></div><div class='stat'><div class='k'>Hostname</div><div class='v'>␀␀</div></div><div class='stat'><div class='k'>LAN / Ethernet IP</div><div class='v'>␀</div></div><div class='stat'><div class='k'>WLAN IP</div><div class='v'>␀␀␀</div></div></div></section><form id='configForm' class='panel' method='post' action='/config/save' onsubmit='syncMqttChecks();syncLedChecks()'><input type='hidden' name='csrf' value='␀␀␀␀</h2><label>␀␀␀␀</label><select id='wifi_networks' name='ssid'>␀<option value='␀ dBm)</option>␀␀<option value=''>␀␀␀<option selected value='␀␀␀␀</select>␀␀␀</option>␀␀␀<div class='actions' style='margin-top:10px'><button id='wifi_scan_button' type='button' class='secondary' onclick='scanConfigWifi()'>␀␀</button><span id='wifi_scan_status' class='muted' role='status' aria-live='polite'></span></div><script>const configWifiScan={csrf:'␀␀␀',german:␀␀␀};␀␀
async function scanConfigWifi(){
  const button=document.getElementById('wifi_scan_button'),status=document.getElementById('wifi_scan_status'),select=document.getElementById('wifi_networks');
  if(!button||!status||!select||button.disabled)return;
  const text=(de,en)=>configWifiScan.german?de:en;
  button.disabled=true;status.textContent=text('Suche...','Scanning...');
  try{
    let method='POST';const deadline=Date.now()+30000;
    while(true){
      const response=await fetch('/config/wifi-scan',{method,headers:method==='POST'?{'X-CSRF-Token':configWifiScan.csrf}:{},cache:'no-store',signal:AbortSignal.timeout(method==='POST'?20000:5000)});
      if(response.status===409&&Date.now()<deadline){status.textContent=text('Funk beschaeftigt...','Radio busy...');await new Promise(resolve=>setTimeout(resolve,500));continue;}
      if(!response.ok)throw new Error('HTTP '+response.status);
      const result=await response.json();
      if(result.status==='complete'){
        const selected=select.value,seen=new Set(),options=[];
        for(const network of result.networks||[]){
          if(!network.ssid||seen.has(network.ssid))continue;
          seen.add(network.ssid);options.push(new Option(network.ssid+' ('+network.rssi+' dBm)',network.ssid));
        }
        if(selected&&!seen.has(selected))options.unshift(new Option(selected,selected));
        if(!options.length)options.push(new Option(text('Keine Netzwerke gefunden - SSID manuell eingeben','No networks found - enter SSID manually'),''));
        select.replaceChildren(...options);if(selected)select.value=selected;
        status.textContent=text('Suche abgeschlossen','Scan complete');break;
      }
      if(result.status!=='scanning'||Date.now()>=deadline)throw new Error('scan '+(Number.isInteger(result.code)?result.code:'timeout'));
      await new Promise(resolve=>setTimeout(resolve,500));method='GET';
    }
  }catch(error){status.textContent=text('Suche fehlgeschlagen - erneut versuchen oder SSID manuell eingeben','Scan failed - try again or enter SSID manually');if(/^(HTTP |scan )/.test(error.message))status.textContent+=' ('+error.message+')';}
  finally{button.disabled=false;}
}
