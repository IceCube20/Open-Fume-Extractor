async function addressBus(){await fetch('/scan?address=1',{method:'POST',cache:'no-store'});setTimeout(load,900)}
async function saveLabel(el){if(!el||el.dataset.saving==='1')return;let v=el.value.trim();if(v===el.dataset.saved)return;el.dataset.saving='1';try{let body=new URLSearchParams();body.set('uid',el.dataset.uid||'');body.set('addr',el.dataset.addr||'0');body.set('label',v);let r=await fetch('/module/label',{method:'POST',body});if(!r.ok)throw await r.text();el.dataset.saved=v;clearFieldDirty(el);setTimeout(load,300)}catch(e){alert('Label failed: '+e)}finally{el.dataset.saving='0'}}
async function saveIoAlias(el){if(!el||el.dataset.saving==='1')return;let v=el.value.trim();if(v===el.dataset.saved)return;el.dataset.saving='1';try{let body=new URLSearchParams();body.set('uid',el.dataset.uid||'');body.set('addr',el.dataset.addr||'0');body.set('key',el.dataset.key||'');body.set('alias',v);let r=await fetch('/module/io_alias',{method:'POST',body});if(!r.ok)throw await r.text();el.dataset.saved=v;clearFieldDirty(el);detailsSig='';routingSig='';setTimeout(load,250)}catch(e){alert('Alias failed: '+e)}finally{el.dataset.saving='0'}}
async function routingSaveOk(r){if(r.ok)return true;alert((uiLang=='de'?'Speichern fehlgeschlagen: ':'Save failed: ')+await r.text());return false}
function setRoutingRuleBusy(i,busy){busy?routingRuleWrites.add(i):routingRuleWrites.delete(i);document.querySelectorAll('#rule_box select,#rule_box button,.route-add').forEach(e=>{e.disabled=!!routingRuleWrites.size})}
async function saveMainInput(){let e=document.getElementById('main_input_sel'),v=dec(e.value);let r=await fetch(`/routing/main?st=${v.t}&sa=${v.a}&sb=${v.b}`,{method:'POST',cache:'no-store'});if(!await routingSaveOk(r))return;clearFieldDirty(e);setTimeout(load,250)}async function saveOutput(){let e=document.getElementById('output_sel');let r=await fetch('/output/select?addr='+e.value,{method:'POST',cache:'no-store'});if(!await routingSaveOk(r))return;clearFieldDirty(e);setTimeout(load,300)}
async function rebootModule(button,addr){let row=button&&button.closest?button.closest('tr'):null,input=row?row.querySelector('.label-edit'):null,name=input?input.value.trim():'';if(!name&&row&&row.cells&&row.cells[2])name=row.cells[2].textContent.trim();let target=hx(addr)+(name?' '+name:'');if(!confirm(t('reboot_module')+' '+target))return;let r=await fetch('/module/reboot?addr='+addr,{method:'POST',cache:'no-store'});if(!r.ok)alert(await r.text());setTimeout(load,1200)}
async function restartMaster(){if(!confirm(t('restart_confirm')))return;await fetch('/restart',{method:'POST',cache:'no-store'});setTimeout(()=>{location.reload()},3500)}
async function routeSet(kind,addr,bit,value){let url='/routing/set?value='+(value?1:0);if(kind=='jbc')url+='&jbc=1';else url+='&addr='+addr+'&bit='+bit;let r=await fetch(url,{method:'POST',cache:'no-store'});if(!await routingSaveOk(r))return;setTimeout(load,150)}
async function ruleChanged(i){
  let se=document.getElementById('rule_s_'+i),te=document.getElementById('rule_t_'+i),draft=routingRuleDrafts[i];
  if(!se||!te||se.disabled||te.disabled||routingRuleWrites.size)return;
  let s=dec(se.value),tgt=dec(te.value);
  if(draft){Object.assign(draft,{enabled:!!(s.t&&tgt.t),source_type:s.t,source_addr:s.a,source_bit:s.b,target_type:tgt.t,target_addr:tgt.a,target_bit:tgt.b,saved:false});if(!draft.enabled)return}
  setRoutingRuleBusy(i,true);
  try{
    let r=await fetch(`/routing/rule?idx=${i}&st=${s.t}&sa=${s.a}&sb=${s.b}&tt=${tgt.t}&ta=${tgt.a}&tb=${tgt.b}`,{method:'POST',cache:'no-store'});
    if(!await routingSaveOk(r))return;
    if(draft){draft.saved=true;draft.persisted=true}
    clearFieldDirty(se);clearFieldDirty(te);routingSig='';setTimeout(load,150);
  }catch(e){alert((uiLang==='de'?'Speichern fehlgeschlagen: ':'Save failed: ')+e.message)}
  finally{setRoutingRuleBusy(i,false)}
}
async function addRule(){
  if(routingRuleWrites.size)return;
  let d=window.lastState||{},rules=d.input_rules||[],i=rules.findIndex((r,i)=>r&&!r.enabled&&!routingRuleDrafts[i]);
  if(i<0){alert(uiLang==='de'?'Maximale Regelanzahl erreicht':'Max rules reached');return}
  routingRuleDrafts[i]={enabled:false,source_type:0,source_addr:0,source_bit:0,target_type:1,target_addr:0,target_bit:0};
  routingSig='';renderRules(d);document.getElementById('rule_s_'+i)?.focus();
}
async function deleteRule(i){
  let draft=routingRuleDrafts[i],se=document.getElementById('rule_s_'+i);
  if(routingRuleWrites.size||(se&&se.disabled))return;
  if(draft&&!draft.persisted){delete routingRuleDrafts[i];routingSig='';renderRules(window.lastState||{});return}
  setRoutingRuleBusy(i,true);
  try{let r=await fetch(`/routing/rule?idx=${i}&st=0&sa=0&sb=0&tt=0&ta=0&tb=0`,{method:'POST',cache:'no-store'});if(!await routingSaveOk(r))return;delete routingRuleDrafts[i];routingSig='';setTimeout(load,150)}catch(e){alert((uiLang==='de'?'Speichern fehlgeschlagen: ':'Save failed: ')+e.message)}finally{setRoutingRuleBusy(i,false)}
}
async function ioSet(addr,bitNo,value){if(document.activeElement)document.activeElement.blur();let ws=document.getElementById('wsl_'+addr);if(ws){let current=Number(ws.value);if(!Number.isFinite(current)||current<30||current>100){let m=((window.lastState&&window.lastState.modules)||[]).find(x=>Number(x.addr)==Number(addr));current=Math.max(30,Math.min(100,Number((m&&m.weller_speed_percent)||30)))}wellerPending[addr]=current;wellerHoldUntil[addr]=Date.now()+2500}await fetch('/io/set?addr='+addr+'&bit='+bitNo+'&value='+(value?1:0),{method:'POST',cache:'no-store'});setTimeout(load,250)}async function wellerFanToggle(addr,value){if(document.activeElement)document.activeElement.blur();let sl=document.getElementById('wsl_'+addr);let speed=Math.max(30,Math.min(100,Number(sl.value||wellerPending[addr]||30)));wellerPending[addr]=speed;wellerHoldUntil[addr]=Date.now()+3000;if(value)await fetch('/weller/set?addr='+addr+'&speed='+speed,{method:'POST',cache:'no-store'});await fetch('/io/set?addr='+addr+'&bit=0&value='+(value?1:0),{method:'POST',cache:'no-store'});setTimeout(load,250)}
async function fanOutputSet(addr,enable,power){if(document.activeElement)document.activeElement.blur();let sl=document.getElementById('io_power_'+addr),lo=Math.max(1,Number(sl&&sl.min||10)),hi=Math.min(100,Number(sl&&sl.max||100));if(hi<lo)hi=lo;let pct=power==null?Number(sl&&sl.value||lo):Number(power||lo);if(enable!==false)pct=Math.max(lo,Math.min(hi,pct));moduleOutputPending[addr]=pct;moduleOutputHoldUntil[addr]=Date.now()+3000;let url='/output/module?addr='+addr+'&power='+Math.round(pct);if(enable!==null&&enable!==undefined)url+='&enable='+(enable?1:0);let r=await fetch(url,{method:'POST',cache:'no-store'});if(!r.ok)alert(await r.text());else clearFieldDirty(sl);setTimeout(load,250)}
async function fanioResetRuntime(addr){if(!confirm(uiLang=='de'?'Filterbetriebszeit wirklich auf 0 zurÃ¼cksetzen?':'Reset filter operating time to 0?'))return;await fanioCal(addr,7)}
async function fanioCal(addr,action,value){
  if(document.activeElement)document.activeElement.blur();
  let body=new URLSearchParams();
  body.set('addr',addr);
  body.set('action',action);
  if(action===3){
    let warn=Number(document.getElementById('io_warn_'+addr).value||0);
    let full=Number(document.getElementById('io_full_'+addr).value||0);
    if(full<=warn){alert('Full raw must be greater than Warn raw');return;}
    body.set('warn',warn);
    body.set('full',full);
  }
  let r=await fetch('/fanio/calibrate',{method:'POST',body,cache:'no-store'});
  if(!r.ok)alert(await r.text());
  else ['io_warn_','io_full_'].forEach(pfx=>clearFieldDirty(document.getElementById(pfx+addr)));
  setTimeout(load,350);
}async function wellerSpeed(addr,value){wellerSlide(addr,value);let r=await fetch('/weller/set?addr='+addr+'&speed='+value,{method:'POST',cache:'no-store'});if(r.ok)clearFieldDirty(document.getElementById('wsl_'+addr));wellerHoldUntil[addr]=Date.now()+3000;setTimeout(load,400)}
async function fanIoPost(addr,body){body.set('addr',addr);let msg=document.getElementById('fi_msg_'+addr);if(msg)msg.textContent=uiLang=='de'?'Wird gespeichert ...':'Saving ...';let r=await fetch('/module/io_config',{method:'POST',body,cache:'no-store'});if(!r.ok){let e=await r.text();if(msg)msg.textContent=e;alert(e);return false}if(msg)msg.textContent=uiLang=='de'?'Gespeichert':'Saved';delete universalDescriptorCache[addr];detailsSig='';routingSig='';setTimeout(()=>load(true),250);return true}
async function fanIoSaveChannel(addr,output,index){let body=new URLSearchParams(),id=p=>document.getElementById(p+'_'+addr+'_'+output+'_'+index);body.set('kind','channel');body.set('output',output);body.set('index',index);body.set('name',id('fi_name').value.trim());body.set('pin',id('fi_pin').value);body.set('enabled',id('fi_en').value);body.set('active_low',id('fi_low').value);body.set('pull',output?0:id('fi_pull').value);await fanIoPost(addr,body)}
function fanIoLegacyPwmUnitSet(addr,unit){let input=document.getElementById('fi_pfreq_'+addr);if(!input)return;let old=input.dataset.unit=='khz'?'khz':'hz',v=Number(input.value);if(!Number.isFinite(v))v=old=='khz'?1:1000;let hz=old=='khz'?v*1000:v,nu=unit=='khz'?'khz':'hz';input.dataset.unit=nu;input.min=nu=='khz'?'0.01':'10';input.max=nu=='khz'?'30':'30000';input.step=nu=='khz'?'0.001':'1';input.value=nu=='khz'?String(Number((hz/1000).toFixed(3))):String(Math.round(hz))}
