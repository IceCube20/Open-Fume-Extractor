function jbcFriendly(c){
  const m={
    0x1C:u('Original Device ID','Original device ID'),0x1D:u('GerÃ¤tesuche','Device discovery'),0x1E:'Device ID',
    0x21:'Firmware',0x30:u('Absaugstufe','Suction level'),0x32:u('Luftstrom','Flow'),0x33:u('Drehzahl','Speed'),
    0x34:u('Flow-Auswahl','Flow select'),0x36:'Stand Intakes',0x38:u('Intake-Aktivierung','Intake activation'),
    0x3A:u('AbsaugverzÃ¶gerung','Suction delay'),0x41:u('Filterstatus','Filter status'),0x45:u('FiltersÃ¤ttigung','Filter saturation'),
    0x59:u('Statusfehler','Status error'),0x5B:u('GerÃ¤tename','Device name'),0x57:u('Dauerabsaugung','Continuous suction')
