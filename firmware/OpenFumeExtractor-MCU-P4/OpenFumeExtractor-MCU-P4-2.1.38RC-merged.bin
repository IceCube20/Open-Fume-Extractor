  let n;if(/^0x[0-9a-f]+$/i.test(s))n=parseInt(s.slice(2),16);else if(/^0b[01]+$/i.test(s))n=parseInt(s.slice(2),2);else if(/^\d+$/.test(s))n=Number(s);else return fallback;
