function diagFormatDhm(def,raw){
  let min=diagBaseMinutes(def,diagTransformBase(def,raw)),neg=min<0;if(neg)min=-min;
  let d=Math.trunc(min/1440),h=Math.trunc((min%1440)/60),m=Math.trunc(min%60);
