function jbcTraceRole(e){
  let tx=String(e&&e.dir)==='UART_TX';
  // JBC FAE is a station-side bridge (incoming RX=request, outgoing TX=response).
  // JBC USB is the PC/host side (outgoing TX=request, incoming RX=response).
