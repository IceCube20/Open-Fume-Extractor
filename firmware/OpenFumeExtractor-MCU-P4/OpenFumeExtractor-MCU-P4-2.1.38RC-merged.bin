p signature verification␀MCU aktualisieren␀␀␀Update MCU␀␀Firmware Ã¼ber RS485 oder die WLAN-Verbindung des Displays senden.␀␀Send firmware over RS485 or the display's WiFi connection.␀␀Zielmodul␀␀␀Target module␀␀␀Kein updatefÃ¤higes Modul online␀␀␀␀No update-capable module online␀Modul-Firmware (.bin)␀␀␀Module firmware (.bin)␀␀Entwicklermodus: Modultyp-PrÃ¼fung Ã¼berspringen␀␀␀␀Developer mode: skip module type check␀␀Modul aktualisieren␀Update Module␀␀␀Installierte Version␀␀␀␀Installed version␀␀␀Passend zur MCU-SDK␀Compatible with MCU SDK␀Freigaben prÃ¼fen␀␀␀Check approved releases␀Firmware laden und prÃ¼fen␀␀Load and verify firmware␀␀␀␀Verwerfen␀␀␀Discard␀Firmwaredatei (.bin)␀␀␀␀Firmware file (.bin)␀␀␀␀C6-UART-Wiederherstellung ist verfÃ¼gbar␀␀␀␀C6 UART recovery is available␀␀␀Legacy-SDIO-Wiederherstellung ausdrÃ¼cklich erlauben␀␀␀␀Explicitly allow legacy SDIO recovery␀␀␀Bei unbekannter C6-Version ist ein Downgrade mÃ¶glich. UART-RÃ¼ckweg erforderlich.␀␀An unknown C6 version may be downgraded. UART recovery access is required.␀␀Nur Ã¼ber LAN. WLAN/Bluetooth werden unterbrochen; danach startet die MCU neu.␀␀Ethernet only. WiFi/Bluetooth will be interrupted; the MCU restarts afterwards.␀C6 aktualisieren␀␀␀␀Update C6␀␀␀Wiederherstellung␀␀␀Recovery␀␀␀␀<p class='msg'>␀<div class='grid'><section class='panel'><h2>MCU OTA</h2><p>␀␀␀␀</p><form id='masterForm' method='post' action='/update/master' enctype='multipart/form-data'><label>␀␀␀</label><input id='master_fw_file' type='file' name='firmware' accept='.bin'><div id='master_fw_info' class='muted' style='margin-top:8px'></div><label class='dev-fw-override' style='display:none;margin-top:10px;padding:10px;border:1px solid #5b4a22;border-radius:8px;background:#211b10;color:#f4c25b'><input type='checkbox' name='unsafe' value='1' style='width:auto;min-height:0;margin-right:8px'><span>␀␀␀␀</span></label><button id='master_update_btn' type='submit'>␀␀␀␀</button><div class='progress'><div id='masterBar' class='bar'></div></div><div id='masterStat' class='upload-stat'></div></form></section>␀<section class='panel'><h2>Module OTA</h2><p>␀␀␀</p><form id='moduleForm' method='post' action='/update/module' enctype='multipart/form-data'><label>␀␀␀</label><select name='addr'>␀␀␀␀' data-type='␀␀␀' data-caps='␀␀␀' data-transport='␀␀' data-name='␀␀␀'>0x␀␀␀␀ - FW ␀␀ - ␀</label><input id='module_fw_file' type='file' name='firmware' accept='.bin'><div id='module_fw_info' class='muted' style='margin-top:8px'></div><label class='dev-fw-override' style='display:none;margin-top:10px;padding:10px;border:1px solid #5b4a22;border-radius:8px;background:#211b10;color:#f4c25b'><input type='checkbox' name='unsafe' value='1' style='width:auto;min-height:0;margin-right:8px'><span>␀␀␀␀</span></label><button id='module_update_btn' type='submit' style='margin-top:16px'>␀␀␀␀</button><div class='progress'><div id='moduleBar' class='bar'></div></div><div id='moduleStat' class='upload-stat'></div></form></section></div>␀␀␀<section class='panel' id='c6_panel'><h2>ESP32-C6 Â· WLAN / Bluetooth</h2><div class='grid'><div><label>␀␀␀␀</label><strong id='c6_current'>-</strong></div><div><label>␀␀␀␀</label><strong>␀␀␀␀</strong></div></div><div class='actions' style='margin-top:12px'><button type='button' class='secondary' id='c6_catalog_check'>␀␀␀␀</button></div><p class='muted' id='c6_catalog_state' role='status'></p><p id='c6_state' role='status'>-</p><div class='actions'><button type='button' id='c6_download'>␀␀␀␀</button><button type='button' class='secondary' id='c6_cancel' disabled>␀␀␀</button></div><label for='c6_file'>␀␀␀␀</label><input id='c6_file' type='file' accept='.bin'><label style='display:flex;gap:8px;align-items:center;margin-top:12px'><input id='c6_recovery' type='checkbox' style='width:auto;min-height:0'>␀␀␀</label><label style='display:flex;gap:8px;align-items:center;margin-top:12px'><input id='c6_legacy' type='checkbox' style='width:auto;min-height:0'>␀␀␀</label><p class='muted'>␀␀␀</p><p class='muted'>␀␀␀</p><div class='actions'><button type='button' id='c6_install' disabled>␀␀␀␀</button><a class='btn secondary' href='␀␀␀␀' target='_blank' rel='noopener noreferrer'>␀␀␀␀</a></div><div class='progress'><div id='c6_bar' class='bar'></div></div></section><script>window.OFE_C6={de:␀␀␀,size:␀␀,url:'␀␀',expected:␀,board:'␀␀␀␀',arduino:'␀',idf:'␀',sha256:'␀␀',catalog:'␀',csrf:'␀␀␀␀'};</script>␀␀␀␀<script>(()=>{
'use strict';
function version(text){if(typeof text!=='string'||!/^\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(text))throw Error('CATALOG_INVALID');const p=text.split('.').map(Number);if(p.some(n=>n>255))throw Error('CATALOG_INVALID');return p[0]*65536+p[1]*256+p[2];}
function inspect(data,cfg,host){
 if(!data||data.schema!==1||!Array.isArray(data.releases)||data.releases.length>32)throw Error('CATALOG_INVALID');
 const ids=new Set(),matches=[];let newest=0;
 for(const r of data.releases){
  const h=r&&r.host,c=r&&r.coprocessor;
  if(!r||typeof r.id!=='string'||r.id.length<1||r.id.length>96||ids.has(r.id)||!['approved','withdrawn'].includes(r.status)||typeof r.board!=='string'||r.transport!=='sdio'||!h||!c||c.chip!=='esp32c6'||!Number.isInteger(c.size)||c.size<1||c.size>2097152||typeof c.sha256!=='string'||!/^[a-f0-9]{64}$/.test(c.sha256)||typeof c.url!=='string'||c.url!==`https://espressif.github.io/arduino-esp32/hosted/esp32c6-v${c.version}.bin`)throw Error('CATALOG_INVALID');
  ids.add(r.id);version(h.arduino_esp32);version(h.esp_idf);const v=version(c.version);if(v!==version(h.esp_hosted))throw Error('CATALOG_INVALID');
  if(r.board!==cfg.board||r.status!=='approved')continue;
  newest=Math.max(newest,v);
  if(h.arduino_esp32===cfg.arduino&&h.esp_idf===cfg.idf&&v===host)matches.push(r);
 }
 if(matches.length>1)throw Error('CATALOG_INVALID');
 const r=matches[0],c=r&&r.coprocessor;
 const pinned=!!c&&version(c.version)===cfg.expected&&c.url===cfg.url&&c.size===cfg.size&&c.sha256===cfg.sha256;
 return {kind:pinned?'approved':r?'master_update':'none',version:pinned?cfg.expected:newest,newerSdk:newest>host};
}
async function load(url){
 const response=await fetch(url,{cache:'no-store',credentials:'omit',referrerPolicy:'no-referrer',signal:AbortSignal.timeout(8000)});
 if(!response.ok)throw Error('HTTP '+response.status);
 const reader=response.body.getReader(),decoder=new TextDecoder();let size=0,text='';
 try{for(;;){const part=await reader.read();if(part.done)break;size+=part.value.byteLength;if(size>32768)throw Error('CATALOG_INVALID');text+=decoder.decode(part.value,{stream:true});}text+=decoder.decode();return JSON.parse(text);}finally{await reader.cancel();reader.releaseLock();}
}
window.OFE_C6_CATALOG={inspect,load};
})();</script>␀␀<script>(()=>{
const cfg=window.OFE_C6,de=cfg.de,$=id=>document.getElementById('c6_'+id);
let token=0,running=false,last=null,refreshing=false,rebooting=false,ownedError='';
let catalog=null,catalogBusy=false,catalogError='',catalogChecked='';
try{token=Number(sessionStorage.getItem('ofe_c6_token')||0)>>>0}catch(_){}
function saveToken(value){token=value;try{if(value)sessionStorage.setItem('ofe_c6_token',String(value));else sessionStorage.removeItem('ofe_c6_token')}catch(_){}}
const say=(a,b)=>de?a:b,ver=n=>n?[(n>>>16)&255,(n>>>8)&255,n&255].join('.'):'-';
const phases=de?['Bereit','Firmware wird geladen','Firmware geprÃ¼ft','C6 wird vorbereitet','C6 wird geschrieben','MCU startet neu','Vorgang beendet','Neustart erforderlich']:['Ready','Loading firmware','Firmware verified','Preparing C6','Writing C6','MCU restarting','Operation ended','Restart required'];
const errors=de?{LAN_REQUIRED:'Stabile LAN-Verbindung erforderlich',NO_PSRAM:'Nicht genÃ¼gend PSRAM',SIZE:'Falsche DateigrÃ¶ÃŸe',OFFSET:'Upload-Reihenfolge ungÃ¼ltig',WRONG_CHIP:'Keine ESP32-C6-Firmware',SHA256:'Firmware-PrÃ¼fsumme stimmt nicht',INCOMPLETE:'Firmware unvollstÃ¤ndig',EXPIRED:'Vorgang abgelaufen',HOST_SDK_MISMATCH:'MCU-SDK passt nicht zur C6-Firmware',C6_UNAVAILABLE:'C6 nicht erreichbar',C6_TOO_OLD:'C6 benÃ¶tigt eine UART-Aktualisierung',C6_NEWER:'C6 ist neuer; Downgrade gesperrt',ALREADY_CURRENT:'C6 ist bereits aktuell',NVS_FAILED:'PrÃ¼fstatus konnte nicht gespeichert werden',BEGIN_FAILED:'C6-Update konnte nicht gestartet werden',WRITE_FAILED:'C6-Schreibfehler',END_FAILED:'C6-PrÃ¼fung fehlgeschlagen',ACTIVATE_FAILED:'C6-Aktivierung nicht bestÃ¤tigt',TASK_FAILED:'Update-Task konnte nicht gestartet werden',TIMEOUT:'Zeitlimit Ã¼berschritten',BUSY:'Anderer Vorgang aktiv'}:{};
const english={LAN_REQUIRED:'Stable Ethernet connection required',NO_PSRAM:'Insufficient PSRAM',SIZE:'Incorrect file size',OFFSET:'Invalid upload order',WRONG_CHIP:'Not ESP32-C6 firmware',SHA256:'Firmware checksum mismatch',INCOMPLETE:'Incomplete firmware',EXPIRED:'Operation expired',HOST_SDK_MISMATCH:'MCU SDK does not match C6 firmware',C6_UNAVAILABLE:'C6 unavailable',C6_TOO_OLD:'C6 requires a UART update',C6_NEWER:'Newer C6 firmware; downgrade blocked',ALREADY_CURRENT:'C6 is already up to date',NVS_FAILED:'Could not save verification state',BEGIN_FAILED:'Could not start C6 update',WRITE_FAILED:'C6 write failed',END_FAILED:'C6 verification failed',ACTIVATE_FAILED:'C6 activation unconfirmed',TASK_FAILED:'Could not start update task',TIMEOUT:'Operation timed out',BUSY:'Another operation is active'};
const describe=code=>code==='C6_VERSION_UNAVAILABLE'?say('C6-Versionsabfrage fehlgeschlagen; keine Firmwaredaten geschrieben','C6 version query failed; no firmware data written'):code==='C6_CONTROL_UNAVAILABLE'?say('C6-Steuerabfrage fehlgeschlagen; keine Firmwaredaten geschrieben','C6 control query failed; no firmware data written'):code==='C6_TOO_OLD'?say('Aeltere C6-Firmware: Legacy-Modus oder UART verwenden','Older C6 firmware: use legacy mode or UART'):(de?errors:english)[code]||String(code||'');
function catalogText(){
 let text='';
 if(catalogBusy)text=say('Freigaben werden geprÃ¼ftâ€¦','Checking approved releasesâ€¦');
 else if(catalogError)text=say('Online-PrÃ¼fung nicht verfÃ¼gbar. Lokale Freigabe bleibt nutzbar.','Online check unavailable. Built-in approval remains available.');
 else if(catalog&&last){try{
  const result=window.OFE_C6_CATALOG.inspect(catalog,cfg,last.host);
  if(result.kind==='approved'){
   if(!last.current)text=say('Installierte C6-Version noch nicht bestÃ¤tigt.','Installed C6 version not yet confirmed.');
   else if(last.current<0x020600)text=describe('C6_TOO_OLD');
   else if(last.current===cfg.expected)text=say('FÃ¼r dieses MCU-SDK aktuell: ','Up to date for this MCU SDK: ')+ver(cfg.expected);
   else if(last.current>cfg.expected)text=say('C6 neuer als lokale Freigabe; Downgrade gesperrt.','C6 newer than built-in approval; downgrade blocked.');
   else text=say('Passendes C6-Update verfÃ¼gbar: ','Compatible C6 update available: ')+ver(cfg.expected);
  }else text=say('Keine passende Online-Freigabe. Lokale Freigabe: ','No matching online approval. Built-in approval: ')+ver(cfg.expected);
  if(result.newerSdk)text+=' Â· '+say('Weitere Freigabe benÃ¶tigt ein aktualisiertes MCU-SDK.','Another approved release requires an updated MCU SDK.');
  else if(result.kind==='master_update')text+=' Â· '+say('Abweichende Freigabe benÃ¶tigt eine aktualisierte MCU-Firmware.','Changed approval requires updated MCU firmware.');
 }catch(_){text=say('UngÃ¼ltiger Updatekatalog. Lokale Freigabe bleibt nutzbar.','Invalid update catalog. Built-in approval remains available.');}}
 else if(catalog)text=say('MCU-Status nicht verfÃ¼gbar.','MCU status unavailable.');
 if(catalogChecked&&!catalogBusy)text+=' Â· '+say('GeprÃ¼ft: ','Checked: ')+catalogChecked;
 $('catalog_state').textContent=text;$('catalog_check').disabled=catalogBusy;
}
async function checkCatalog(){if(catalogBusy)return;catalogBusy=true;catalogError='';catalogText();try{const data=await window.OFE_C6_CATALOG.load(cfg.catalog);window.OFE_C6_CATALOG.inspect(data,cfg,cfg.expected);catalog=data;catalogChecked=new Date().toLocaleTimeString(de?'de-DE':'en-GB');}catch(e){catalog=null;catalogError=e.message;catalogChecked='';}finally{catalogBusy=false;catalogText();}}
function phaseText(s){if([0,2].includes(s.phase)&&s.current===s.expected)return describe('ALREADY_CURRENT');if([0,2].includes(s.phase)&&s.current>0&&s.current<0x020600)return describe('C6_TOO_OLD');return phases[s.phase]||'-';}
function controls(){const s=last,busy=s&&s.phase>0&&s.phase!==6,needsLegacy=s&&(!s.current||s.current<0x020600); $('download').disabled=running||busy||!s||!s.lan||s.other_busy||s.host!==s.expected; $('file').disabled=$('download').disabled; $('cancel').disabled=running||!token||!s||![1,2].includes(s.phase);$('legacy').disabled=running||!s||[3,4,5,7].includes(s.phase)||!needsLegacy;if(!needsLegacy)$('legacy').checked=false;$('install').disabled=running||!token||!s||s.phase!==2||!s.lan||s.other_busy||s.host!==s.expected||s.current>=s.expected||!$('recovery').checked||(needsLegacy&&!$('legacy').checked);}
async function request(action,args={},body){const q=new URLSearchParams(args);const r=await fetch('/update/c6/'+action+'?'+q,{method:'POST',headers:{'X-CSRF-Token':cfg.csrf},body,cache:'no-store'});let s;try{s=await r.json()}catch(_){throw Error('HTTP '+r.status)}if(!r.ok||!s.ok)throw Error(describe(s.error));return s;}
async function refresh(){if(refreshing||document.hidden)return;refreshing=true;const observedToken=token;try{const r=await fetch('/update/c6/status?token='+observedToken,{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);last=await r.json();if(token===observedToken&&token&&!last.owned)saveToken(0);$('current').textContent=ver(last.current);let text=phaseText(last);if(last.error!=='OK')text+=' Â· '+describe(last.error);if(!last.lan&&![3,4,5,7].includes(last.phase))text+=' Â· '+say('LAN erforderlich','Ethernet required');if(last.verification===1)text+=' Â· '+say('Version nach Neustart bestÃ¤tigt','Version confirmed after restart');if(last.verification===2)text+=' Â· '+say('Letztes Update nicht bestÃ¤tigt','Previous update unconfirmed');$('state').textContent=ownedError||text;const count=last.phase>=3?last.written:last.received;$('bar').style.width=Math.round(100*count/cfg.size)+'%';if(last.phase===5)rebooting=true;controls();catalogText();}catch(e){last=null;$('state').textContent=rebooting?say('MCU startet neuâ€¦','MCU restartingâ€¦'):e.message;controls();catalogText();}finally{refreshing=false}}
async function stage(file){if(running)return;running=true;ownedError='';controls();try{if(!file||file.size!==cfg.size)throw Error(describe('SIZE'));const begin=await request('begin',{size:file.size});saveToken(begin.token);for(let offset=0;offset<file.size;){const end=Math.min(offset+16384,file.size),data=new FormData();data.append('firmware',file.slice(offset,end),'c6.bin');const reply=await request('chunk',{token,offset},data);if(reply.received!==end)throw Error(describe('OFFSET'));offset=end;$('bar').style.width=Math.round(100*offset/file.size)+'%';$('state').textContent=phases[1]+' '+Math.round(100*offset/file.size)+'%';}await request('seal',{token});}catch(e){ownedError=e.message;if(token){try{await request('cancel',{token})}catch(_){}saveToken(0);}}finally{running=false;await refresh();controls();}}
$('download').addEventListener('click',async()=>{if(running)return;running=true;ownedError='';controls();$('state').textContent=say('Firmware wird von Espressif geladenâ€¦','Loading firmware from Espressifâ€¦');let file;try{const r=await fetch(cfg.url,{credentials:'omit',referrerPolicy:'no-referrer',signal:AbortSignal.timeout(60000)});if(!r.ok)throw Error('HTTP '+r.status);file=await r.blob();if(file.size!==cfg.size)throw Error(describe('SIZE'));}catch(e){ownedError=e.message;$('state').textContent=ownedError;}finally{running=false;controls();}if(file)await stage(file);});
$('file').addEventListener('change',()=>stage($('file').files[0]));
$('recovery').addEventListener('change',controls);
$('legacy').addEventListener('change',controls);
$('catalog_check').addEventListener('click',checkCatalog);
$('cancel').addEventListener('click',async()=>{try{await request('cancel',{token});saveToken(0);ownedError='';await refresh()}catch(e){$('state').textContent=e.message}});
$('install').addEventListener('click',async()=>{const legacy=$('legacy').checked;if($('install').disabled||!confirm(legacy?say('Legacy-C6-Wiederherstellung starten? Die installierte Version ist unbekannt oder alt. Ein Downgrade ist moeglich. UART-Wiederherstellung muss verfuegbar sein.','Start legacy C6 recovery? The installed version is unknown or old. A downgrade is possible. UART recovery must be available.'):say('C6 aktualisieren und danach die MCU neu starten? WLAN und Bluetooth werden unterbrochen.','Update C6 and restart the MCU afterwards? WiFi and Bluetooth will be interrupted.')))return;running=true;controls();try{await request('install',{token,recovery:'1',legacy:legacy?'1':'0'});saveToken(0);ownedError='';}catch(e){ownedError=e.message;}finally{running=false;await refresh();}});
document.addEventListener('visibilitychange',refresh);controls();refresh();checkCatalog();setInterval(refresh,1000);
})();</script>␀␀␀<script>␀␀␀␀let DEV_MODE=false;␀localStorage.setItem('ofe_dev_mode',DEV_MODE?'1':'0');function applyUpdateDevMode(){document.querySelectorAll('.dev-fw-override').forEach(function(e){e.style.display=DEV_MODE?'block':'none';});}applyUpdateDevMode();fetch('/state',{cache:'no-store'}).then(function(r){return r.json()}).then(function(d){if(typeof d.developer_mode==='boolean'){DEV_MODE=!!d.developer_mode;localStorage.setItem('ofe_dev_mode',DEV_MODE?'1':'0');applyUpdateDevMode();}}).catch(function(){});const RS485_FW_CHUNK=188;const RS485_FW_CHUNK_DISPLAY=188;const MODULE_FW_HTTP_CHUNK=8192;const MASTER_FW_CHUNK=32768;␀function u(de,en){return UI_DE?de:en;}function fmt(n){if(!n)return'0 B';var uu=['B','KB','MB'];var i=0;while(n>=1024&&i<uu.length-1){n/=1024;i++;}return n.toFixed(i?1:0)+' '+uu[i];}␀␀␀function fmtSpeed(bps){if(!bps||bps<1)return'-';return (bps/1024).toFixed(1)+' kB/s';}function fmtEta(sec){if(!isFinite(sec)||sec<0)return'-';sec=Math.ceil(sec);var m=Math.floor(sec/60),s=sec%60;return m?m+'m '+String(s).padStart(2,'0')+'s':s+'s';}␀␀␀␀function send(form,bar,stat,url,doneText){form.addEventListener('submit',function(e){e.preventDefault();var file=form.querySelector('input[type=file]').files[0];if(!file){stat.textContent=u('Keine Firmwaredatei ausgewÃ¤hlt','No firmware file selected');return;}var xhr=new XMLHttpRequest();bar.style.width='0%';stat.textContent=u('Update wird gestartet...','Starting...');xhr.upload.onprogress=function(ev){if(ev.lengthComputable){var p=Math.round(ev.loaded*100/ev.total);bar.style.width=p+'%';stat.textContent=p+'% ('+fmt(ev.loaded)+' / '+fmt(ev.total)+')';}else{stat.textContent=u('Upload lÃ¤uft...','Uploading...');}};xhr.onload=function(){if(xhr.status>=200&&xhr.status<300){bar.style.width='100%';stat.textContent=(xhr.responseText||doneText)+' '+u('Weiterleitung in wenigen Sekunden...','Redirecting in a few seconds...');setTimeout(function(){location.href='/';},9000);setTimeout(function(){location.reload();},15000);}else{stat.textContent=xhr.responseText||('Failed: HTTP '+xhr.status);}};xhr.onerror=function(){stat.textContent=u('Upload-Verbindung fehlgeschlagen','Upload connection failed');};xhr.open('POST',url(file));xhr.send(new FormData(form));});}␀␀␀function postBlob(url,blob){return new Promise(function(ok,fail){var x=new XMLHttpRequest();var fd=new FormData();fd.append('firmware',blob,'chunk.bin');x.onload=function(){if(x.status>=200&&x.status<300)ok(x.responseText);else fail(x.responseText||('HTTP '+x.status));};x.onerror=function(){fail(u('Verbindung fehlgeschlagen','Connection failed'));};x.open('POST',url);x.send(fd);});}␀␀␀function sleep(ms){return new Promise(function(ok){setTimeout(ok,ms);});}␀␀␀async function abortOwnedUpdate(run,url){if(run.beginPromise){var begin=await run.beginPromise;if(begin.ok)run.started=true;}if(!run.started)return;var r=await fetch(url,{method:'POST'}),t=await r.text();if(!r.ok)throw(t||('HTTP '+r.status));}␀async function waitMasterBack(stat,version,oldVersion,oldUptime,t0){await sleep(2500);for(var i=0;i<35;i++){try{var r=await fetch('/state',{cache:'no-store'});if(r.ok){var d=await r.json(),matches=version&&version!=='-'&&d.master_fw===version,projected=(oldUptime+performance.now()-t0)%4294967296,restarted=Number(d.uptime_ms)+2000<projected;if(matches&&(oldVersion!==version||restarted)){stat.textContent=u('MCU online: FW ','MCU online: FW ')+d.master_fw;location.href='/';return true;}}}catch(e){}stat.textContent=u('MCU startet neu...','MCU rebooting...')+' '+(i+1);await sleep(2000);}stat.textContent=u('MCU nicht erreichbar oder Firmware-Version nicht bestÃ¤tigt. Bitte Statusseite prÃ¼fen.','MCU unreachable or firmware version unconfirmed. Check the status page.');return false;}␀function fwNameOk(type,file){var n=file.name.toLowerCase();var fan=n.indexOf('fanio')>=0||n.indexOf('fan_io')>=0||n.indexOf('fan-io')>=0;var pro=n.indexOf('pro')>=0;if(type==1)return n.indexOf('jbc')>=0&&n.indexOf('usb')<0;if(type==9)return n.indexOf('jbc')>=0&&n