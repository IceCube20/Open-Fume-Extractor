utton class="secondary" onclick="universalExport(${m.addr})">Export</button><button onclick="universalSave(${m.addr})">${uiLang=='de'?'Ins Modul speichern':'Save to module'}</button></div><button class="secondary danger" onclick="universalClearProfile(${m.addr})">${uiLang=='de'?'Profil-Entities lÃ¶schen':'Clear profile entities'}</button><div id="uni_msg_${m.addr}" class="uni-save-state"></div></div></details><details class="universal-debug"><summary>Debug / Descriptor</summary><div class="universal-entities" id="uni_debug_entities_${m.addr}"></div><details class="uni-descriptor"><summary>Descriptor <span id="uni_desc_state_${m.addr}">-</span></summary><pre id="uni_descriptor_${m.addr}"></pre></details></details>${moduleMeta(m)}</div>`}
if(m.type==6){det+=`<div class="tile module-card display-card core-style"><div class="module-head"><div class="module-title">${mn(m)}</div><div class="module-head-main"><div class="module-identity"><span class="module-icon">${moduleMonitorGlyph()}</span><div class="module-head-copy"><div class="module-type">${m.type_name||'Display'}</div><div class="module-address">${hx(m.addr)}</div></div></div><div class="module-statuses"><span id="display_conn_${m.addr}" class="pill">-</span></div></div></div><div class="jbu-hero"><div class="jbu-hero-top"><div class="jbu-station-name">${m.type_name||'Display'}</div><div class="jbu-badges"><span class="jbu-chip proto">${uiLang=='de'?'Bedienfeld':'Control panel'}</span><span class="jbu-chip kind">${(String(m.type_name||'').match(/\d+x\d+/)||['Display'])[0]}</span></div></div></div><div class="display-settings"><div class="range-control"><div class="range-head"><span>${t('brightness')}</span><strong id="dbri_v_${m.addr}">85 %</strong></div><input id="dbri_${m.addr}" type="range" min="10" max="100" value="85" oninput="displayBrightnessInput(${m.addr},this.value)" onchange="displaySet(${m.addr})"></div><div class="metric-line"><div><label>${t('language')}</label><select id="dlang_${m.addr}" onchange="displaySet(${m.addr})"><option value="0">English</option><option value="1">Deutsch</option></select></div><div><label>${t('theme')}</label><select id="dtheme_${m.addr}" onchange="displaySet(${m.addr})"><option value="0">Dark</option><option value="1">Light</option></select></div></div><label>${t('screensaver')}</label><select id="dsaver_${m.addr}" onchange="displaySet(${m.addr})"><option value="0">${t('disabled')}</option><option value="1">1 ${t('minute')}</option><option value="2">2 ${t('minutes')}</option><option value="5">5 ${t('minutes')}</option><option value="10">10 ${t('minutes')}</option></select><div id="dlight_settings_${m.addr}" class="metric-line display-backlight-settings" hidden><div><label>${uiLang==='de'?'Beleuchtung ausschalten':'Backlight off'}</label><select id="dlight_mode_${m.addr}" onchange="displayBacklightSet(${m.addr})"><option value="0">${t('disabled')}</option><option value="1">${uiLang==='de'?'Nur im Energiesparmodus':'Only in power saving'}</option><option value="2">${uiLang==='de'?'Immer':'Always'}</option></select></div><div><label>${uiLang==='de'?'Ausschalten nach':'Turn off after'}</label><select id="dlight_delay_${m.addr}" onchange="displayBacklightSet(${m.addr})">${Array.from({length:60},(_,i)=>`<option value="${i+1}">${i+1} min</option>`).join('')}</select></div></div></div>${moduleMeta(m)}</div>`}});document.getElementById('details').innerHTML=det}
const renderDetailsCore=renderDetails;
renderDetails=function(d){renderDetailsCore(d);(d.modules||[]).forEach(m=>{if(!((m.type==2||m.type==3)&&(m.caps&65536)))return;let anchor=document.getElementById('io_state_'+m.addr),card=anchor&&anchor.closest('.module-card');if(!card)return;card.querySelectorAll('.fanio-legacy-extra').forEach(e=>e.style.display='none');let panel=fanIoEditorCard(m),meta=Array.from(card.children).find(e=>e.classList&&e.classList.contains('led-pair'));if(meta)meta.insertAdjacentHTML('beforebegin',panel);else card.insertAdjacentHTML('beforeend',panel)})}
function updateDetails(d){
set('route_summary',availableRouteCount(d)+' '+t('additional_rules'));
