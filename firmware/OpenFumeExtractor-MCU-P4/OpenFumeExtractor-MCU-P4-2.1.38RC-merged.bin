    if(p.length){h=jbcField('Conti',jbcUsbContiSpeed(p[0]),p[0]?'primary':'')+(p.length>1?jbcField('Port mask','0x'+hex2(p[1])):'')+(p.length>2?jbcField(u('Erweitert','Extended'),'0x'+hex2(p[2])):'');summary=jbcUsbContiSpeed(p[0]);}
  }
