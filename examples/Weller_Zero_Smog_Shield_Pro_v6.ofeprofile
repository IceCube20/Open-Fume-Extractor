profile=Weller Zero Smog Shield Pro
station=Weller Zero Smog
baud=1200
frame=8N1
protocol=WELLER_ASCII
checksum=WELLER_SUM8
line_end=NONE

entity.1.type=number
entity.1.name=Leistung
entity.1.key=power
entity.1.role=main_output_power
entity.1.unit=%
entity.1.min=30
entity.1.max=100
entity.1.step=1
entity.1.access=rw
entity.1.poll=S
entity.1.match=S###
entity.1.set=d{value:03}

entity.2.type=switch
entity.2.name=Arbeitslicht
entity.2.key=light
entity.2.access=rw
entity.2.value_on=100
entity.2.value_off=0
entity.2.poll=A
entity.2.match=A###
entity.2.set_on=a100A
entity.2.set_off=a000A

entity.3.type=sensor
entity.3.name=Drehzahl
entity.3.key=rpm
entity.3.role=main_output_rpm
entity.3.unit=rpm
entity.3.scale=10
entity.3.access=ro
entity.3.poll=D
entity.3.match=D###

entity.4.type=select
entity.4.name=Filterlaufzeit
entity.4.key=filter_time
entity.4.access=rw
entity.4.options=1h|2h|4h|8h|16h|24h|48h|96h|160h
entity.4.values=006|012|024|048|096|144|288|576|960
entity.4.poll=F
entity.4.match=F###
entity.4.set=f{value}

entity.5.type=sensor
entity.5.name=Filterstatus
entity.5.key=filter_status
entity.5.access=ro
entity.5.poll=L
entity.5.match=L###

entity.6.type=button
entity.6.name=Filter zurücksetzen
entity.6.key=filter_reset
entity.6.access=wo
entity.6.set=r001

entity.7.type=switch
entity.7.name=Lüfter
entity.7.key=fan
entity.7.role=main_output_enable
entity.7.access=rw
entity.7.set_on=N
entity.7.set_off=M
