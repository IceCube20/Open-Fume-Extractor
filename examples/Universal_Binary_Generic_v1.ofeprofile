# Open Fume Extractor Universal RS232 - generic binary example
# Example frame: AA 55 LEN CMD PAYLOAD... CRC16-CCITT
# LEN contains payload bytes. Total RX length = LEN + 6 (AA 55 + LEN + CMD + CRC16).
profile=Generic Binary UART
station=Binary device
baud=9600
frame=8N1
protocol=BINARY
checksum=CRC16_CCITT_BE
line_end=NONE
binary_frame=LENGTH_U8
binary_start=AA 55
binary_length_offset=2
binary_length_adjust=6

entity.1.type=sensor
entity.1.name=Drehzahl
entity.1.key=rpm
entity.1.access=ro
entity.1.role=main_output_rpm
entity.1.unit=rpm
entity.1.poll=AA 55 00 01
entity.1.match=AA 55 ?? 81
entity.1.poll_ms=1000
entity.1.value_offset=4
entity.1.value_type=u16be

entity.2.type=number
entity.2.name=Leistung
entity.2.key=power
entity.2.access=rw
entity.2.role=main_output_power
entity.2.unit=%
entity.2.poll=AA 55 00 02
entity.2.match=AA 55 ?? 82
entity.2.poll_ms=1000
entity.2.value_offset=4
entity.2.value_type=u8
entity.2.min=0
entity.2.max=100
entity.2.step=1
entity.2.set=AA 55 01 20 {value:u8}

entity.3.type=switch
entity.3.name=Lüfter
entity.3.key=fan
entity.3.access=rw
entity.3.role=main_output_enable
entity.3.poll=AA 55 00 03
entity.3.match=AA 55 ?? 83
entity.3.poll_ms=1000
entity.3.value_offset=4
entity.3.value_type=u8
entity.3.value_on=1
entity.3.value_off=0
entity.3.set_on=AA 55 01 30 01
entity.3.set_off=AA 55 01 30 00
